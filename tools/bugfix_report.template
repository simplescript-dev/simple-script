[meta]
type = bugfix
title = <bug 简述>
date = <YYYY-MM-DD>
commit = <commit hash 或 uncommitted>

[found]
symptom = <可观测的 bug 症状，包括错误信息或异常输出>

[isolate]
test_file = <回归测试文件路径>
stash_exit = <回退 fix 后测试 exit code，必须 != 0>

[analyze]
broken = <什么机制坏了>
why = <为什么会坏——设计缺口>
fix = <改了什么——机制层面>
same_pattern_count = <同模式 grep 残留数，必须 == 0>
root_or_workaround = <root 或 workaround，必须 == root>

[resolve]
fix_exit = <当前 fix 下测试 exit code，必须 == 0>
net_new_ifs = <bootstrap/ 中净新增 if 语句数>
net_new_fns = <bootstrap/ 中净新增函数数>

[verify]
bootstrap = <PASS 或 FAIL>
test_passed = <通过数>
test_failed = <失败数>
test_known_fail = <已知失败数>
