// gen_runtime.ss — Runtime core: dispatcher, libc declarations, globals, helpers, RC

import { emitRuntimeStringOps, emitRuntimeConversions } from "./rt/gen_rt_string"
import { emitRuntimeArrayOps } from "./rt/gen_rt_array"
import { emitRuntimeIO, emitRuntimeProcess, emitRuntimeMath } from "./rt/gen_rt_io"
import { emitRuntimeShell } from "./rt/gen_rt_shell"
import { emitRuntimeMap } from "./rt/gen_rt_map"
import { emitRuntimeFS, emitRuntimeNet, emitRuntimeExceptions, emitRuntimeIsInstance, emitRuntimeInotify } from "./rt/gen_rt_system"
import { emitRuntimeRef } from "./rt/gen_rt_ref"
import { emitRuntimeThread } from "./rt/gen_rt_thread"
import { emitRuntimeChannel } from "./rt/gen_rt_channel"

function emitRuntimeDefs() {
    emitLibcDecls()
    emitRuntimeGlobals()
    emitRuntimeHelpers()
    emitRuntimeRC()
    emitRuntimeStringOps()
    emitRuntimeIO()
    emitRuntimeArrayOps()
    emitRuntimeConversions()
    emitRuntimeProcess()
    emitRuntimeShell()
    emitRuntimeMath()
    emitRuntimeFS()
    emitRuntimeNet()
    emitRuntimeMap()
    emitRuntimeExceptions()
    emitRuntimeIsInstance()
    emitRuntimeInotify()
    emitRuntimeTestFramework()
    emitRuntimeRef()
    emitRuntimeThread()
    emitRuntimeChannel()
}

// ── libc declarations ─────────────────────────────────────────

function emitLibcDecls() {
    // I/O
    emitIR("declare i32 @puts(ptr)")
    emitIR("declare i32 @fputs(ptr, ptr)")
    emitIR("declare i32 @fflush(ptr)")
    emitIR("declare ptr @fopen(ptr, ptr)")
    emitIR("declare i32 @fclose(ptr)")
    emitIR("declare i32 @fseek(ptr, i64, i32)")
    emitIR("declare i64 @ftell(ptr)")
    emitIR("declare i64 @fread(ptr, i64, i64, ptr)")
    emitIR("declare ptr @fgets(ptr, i32, ptr)")
    // String
    emitIR("declare i64 @strlen(ptr)")
    emitIR("declare ptr @strdup(ptr)")
    emitIR("declare ptr @strstr(ptr, ptr)")
    emitIR("declare i32 @strcmp(ptr, ptr)")
    emitIR("declare i32 @strncmp(ptr, ptr, i64)")
    // Memory (libc)
    emitIR("declare ptr @malloc(i64)")
    emitIR("declare ptr @calloc(i64, i64)")
    emitIR("declare ptr @realloc(ptr, i64)")
    emitIR("declare void @free(ptr)")
    emitIR("declare ptr @memcpy(ptr, ptr, i64)")
    emitIR("declare ptr @memset(ptr, i32, i64)")
    // Memory (mimalloc — class instance allocation)
    emitIR("declare ptr @mi_calloc(i64, i64)")
    emitIR("declare void @mi_free(ptr)")
    // Conversion
    emitIR("declare i32 @atoi(ptr)")
    emitIR("declare double @atof(ptr)")
    emitIR("declare i32 @snprintf(ptr, i64, ptr, ...)")
    emitIR("declare i32 @printf(ptr, ...)")
    // Math
    emitIR("declare double @sqrt(double)")
    emitIR("declare double @fabs(double)")
    emitIR("declare double @floor(double)")
    emitIR("declare double @ceil(double)")
    emitIR("declare double @round(double)")
    emitIR("declare double @pow(double, double)")
    emitIR("declare double @log(double)")
    emitIR("declare double @sin(double)")
    emitIR("declare double @cos(double)")
    emitIR("declare double @tan(double)")
    emitIR("declare double @asin(double)")
    emitIR("declare double @acos(double)")
    emitIR("declare double @atan(double)")
    emitIR("declare double @atan2(double, double)")
    emitIR("declare double @exp(double)")
    emitIR("declare double @log10(double)")
    emitIR("declare double @log2(double)")
    emitIR("declare double @trunc(double)")
    emitIR("declare double @hypot(double, double)")
    emitIR("declare double @fmod(double, double)")
    emitIR("declare i32 @rand()")
    emitIR("declare void @srand(i32)")
    // Exception handling (setjmp/longjmp)
    emitIR("declare i32 @setjmp(ptr)")
    emitIR("declare void @longjmp(ptr, i32)")
    // Process
    emitIR("declare void @exit(i32)")
    emitIR("declare i32 @system(ptr)")
    emitIR("declare ptr @popen(ptr, ptr)")
    emitIR("declare i32 @pclose(ptr)")
    emitIR("declare ptr @getenv(ptr)")
    emitIR("declare i32 @atexit(ptr)")
    // Time
    emitIR("declare i64 @time(ptr)")
    emitIR("declare i32 @clock_gettime(i32, ptr)")
    // Filesystem
    emitIR("declare i32 @mkdir(ptr, i32)")
    emitIR("declare i32 @stat(ptr, ptr)")
    emitIR("declare ptr @opendir(ptr)")
    emitIR("declare ptr @readdir(ptr)")
    emitIR("declare i32 @closedir(ptr)")
    emitIR("declare i32 @remove(ptr)")
    emitIR("declare i32 @rename(ptr, ptr)")
    // Network
    emitIR("declare i32 @socket(i32, i32, i32)")
    emitIR("declare i32 @bind(i32, ptr, i32)")
    emitIR("declare i32 @listen(i32, i32)")
    emitIR("declare i32 @accept(i32, ptr, ptr)")
    emitIR("declare i32 @setsockopt(i32, i32, i32, ptr, i32)")
    emitIR("declare i64 @read(i32, ptr, i64)")
    emitIR("declare i64 @write(i32, ptr, i64)")
    emitIR("declare i32 @close(i32)")
    emitIR("declare i16 @htons(i16)")
    emitIR("declare i32 @connect(i32, ptr, i32)")
    emitIR("declare i32 @getaddrinfo(ptr, ptr, ptr, ptr)")
    emitIR("declare void @freeaddrinfo(ptr)")
    // inotify
    emitIR("declare i32 @inotify_init()")
    emitIR("declare i32 @inotify_add_watch(i32, ptr, i32)")
    emitIR("declare i32 @poll(ptr, i64, i32)")
    // Sort
    emitIR("declare void @qsort(ptr, i64, i64, ptr)")
    // Pthreads (D082 Phase 2)
    emitIR("declare i32 @pthread_create(ptr, ptr, ptr, ptr)")
    emitIR("declare i32 @pthread_detach(ptr)")
    emitIR("declare i32 @pthread_mutex_init(ptr, ptr)")
    emitIR("declare i32 @pthread_mutex_lock(ptr)")
    emitIR("declare i32 @pthread_mutex_unlock(ptr)")
    emitIR("declare i32 @pthread_cond_init(ptr, ptr)")
    emitIR("declare i32 @pthread_cond_wait(ptr, ptr)")
    emitIR("declare i32 @pthread_cond_signal(ptr)")
    emitIR("declare i32 @pthread_cond_broadcast(ptr)")
    emitIR("declare i64 @sysconf(i32)")
    emitIR("")
}

// ── Globals ───────────────────────────────────────────────────

function emitRuntimeGlobals() {
    emitIR("@stdin = external global ptr")
    emitIR("@stdout = external global ptr")
    emitIR("@ss_argc = global i32 0, align 4")
    emitIR("@ss_argv = global ptr null, align 8")
    // Exception handling: jmp_buf stack (200 bytes per level, max 16 deep)
    emitIR("@ss_jmpbuf = global [3200 x i8] zeroinitializer, align 16")
    emitIR("@ss_exc_depth = global i32 0, align 4")
    emitIR("@ss_exc_msg = global ptr null, align 8")
    emitIR("@ss_exc_obj = global ptr null, align 8")
    emitIR("@ss_exc_is_obj = global i32 0, align 4")
    emitIR(`@.rt.str.uncaught = constant [21 x i8] c"uncaught exception: \\00"`)
    // Format strings (use @.rt. prefix to avoid collision with user string consts)
    emitIR(`@.rt.fmt.d = constant [3 x i8] c"%d\\00"`)
    emitIR(`@.rt.fmt.g = constant [3 x i8] c"%g\\00"`)
    emitIR(`@.rt.fmt.lld = constant [5 x i8] c"%lld\\00"`)
    emitIR(`@.rt.str.true = constant [5 x i8] c"true\\00"`)
    emitIR(`@.rt.str.false = constant [6 x i8] c"false\\00"`)
    emitIR(`@.rt.str.empty = constant [1 x i8] c"\\00"`)
    emitIR(`@.rt.str.rb = constant [3 x i8] c"rb\\00"`)
    emitIR(`@.rt.str.w = constant [2 x i8] c"w\\00"`)
    emitIR(`@.rt.str.a = constant [2 x i8] c"a\\00"`)
    emitIR(`@.rt.str.nl = constant [2 x i8] c"\\0A\\00"`)
    // D080: exec() process capture
    emitIR("@ss_last_exit_code = global i32 0, align 4")
    emitIR(`@.rt.str.r = constant [2 x i8] c"r\\00"`)
    // D079: Test framework globals
    emitIR("@ss_test_total = global i32 0, align 4")
    emitIR("@ss_test_passed = global i32 0, align 4")
    emitIR("@ss_test_failed = global i32 0, align 4")
    emitIR(`@.rt.str.test_pass = constant [9 x i8] c"  PASS: \\00"`)
    emitIR(`@.rt.str.test_fail = constant [9 x i8] c"  FAIL: \\00"`)
    emitIR(`@.rt.str.test_sep = constant [4 x i8] c" - \\00"`)
    emitIR(`@.rt.str.test_summary1 = constant [8 x i8] c"Tests: \\00"`)
    emitIR(`@.rt.str.test_passed = constant [10 x i8] c" passed, \\00"`)
    emitIR(`@.rt.str.test_failed = constant [10 x i8] c" failed, \\00"`)
    emitIR(`@.rt.str.test_total = constant [7 x i8] c" total\\00"`)
    // Class destructor table: tag >= 10 indexes into this (tag-10)
    emitIR("@ss_class_dtor = global [100 x ptr] zeroinitializer")
    // TypeInfo type: { drop_fn, deep_clone_fn, shallow_clone_fn, size, name, class_id }
    emitIR("%TypeInfo = type { ptr, ptr, ptr, i64, ptr, i32, ptr }")
    // ObjHeader type: { rc:i32, type_info:ptr } — first two fields of every class instance
    // D168 §A.3 D3=ii: rc i32 → i64 (零空间代价 — padding 4B 升级为有意义 RC 高位 + future-proof for weak/finalize)
    emitIR("%ObjHeader = type { i64, ptr }")
    emitIR("")
}

// ── Internal helpers ──────────────────────────────────────────

function emitRuntimeHelpers() {
    // ss_rt_ensure_cap(bufp, capp, needed) — grow buffer if needed
    // bufp: ptr to buffer pointer, capp: ptr to capacity i64, needed: required bytes
    // Returns the (possibly reallocated) buffer pointer
    emitIR("define ptr @ss_rt_ensure_cap(ptr %bufp, ptr %capp, i64 %needed) {")
    irLabel("entry")
    irLoad("cap", "i64", "%capp")
    irICmp("fits", "slt", "i64", "%needed", "%cap")
    irBrCond("fits", "ok", "grow")
    irLabel("grow")
    irMul("dbl", "i64", "%cap", "2")
    irICmp("enough", "sge", "i64", "%dbl", "%needed")
    irAdd("min", "i64", "%needed", "256")
    irSelect("newcap", "enough", "i64", "%dbl", "%min")
    irLoad("oldbuf", "ptr", "%bufp")
    irCall("newbuf", "ptr", "ss_rc_realloc", "ptr %oldbuf, i64 %newcap")
    irStore("ptr", "%newbuf", "%bufp")
    irStore("i64", "%newcap", "%capp")
    irBr("ok")
    irLabel("ok")
    irLoad("buf", "ptr", "%bufp")
    irRet("ptr", "%buf")
    emitIR("}")
    emitIR("")
}

// ── Reference counting ────────────────────────────────────────
// Object layout: [rc:i64][tag:i32][pad:i32] | [user data...]
//                ^raw ptr (malloc'd)          ^user ptr (returned, +16)
// Tags: 0=string, 1=array(scalar), 2=map, 3=class(no dtor), 5=array(ptr), >=10=class(with dtor)

function emitRuntimeRC() {
    // ss_rc_alloc(size, tag) → user ptr with rc=1
    emitIR("define ptr @ss_rc_alloc(i64 %size, i32 %tag) {")
    irLabel("entry")
    irAdd("total", "i64", "%size", "16")
    irCall("raw", "ptr", "malloc", "i64 %total")
    irStore("i64", "1", "%raw")
    irGEP("tagp", "i8", "%raw", "8")
    irStore("i32", "%tag", "%tagp")
    irGEP("padp", "i8", "%raw", "12")
    irStore("i32", "1397969747", "%padp")
    irGEP("user", "i8", "%raw", "16")
    irRet("ptr", "%user")
    emitIR("}")
    emitIR("")

    // ss_rc_calloc(size, tag) → zeroed user data with rc=1
    emitIR("define ptr @ss_rc_calloc(i64 %size, i32 %tag) {")
    irLabel("entry")
    irCall("buf", "ptr", "ss_rc_alloc", "i64 %size, i32 %tag")
    irCall("_1", "ptr", "memset", "ptr %buf, i32 0, i64 %size")
    irRet("ptr", "%buf")
    emitIR("}")
    emitIR("")

    // ss_rc_realloc(user_ptr, new_data_size) → new user ptr (preserves header)
    emitIR("define ptr @ss_rc_realloc(ptr %p, i64 %size) {")
    irLabel("entry")
    irGEP("raw", "i8", "%p", "-16")
    irAdd("total", "i64", "%size", "16")
    irCall("newraw", "ptr", "realloc", "ptr %raw, i64 %total")
    irGEP("user", "i8", "%newraw", "16")
    irRet("ptr", "%user")
    emitIR("}")
    emitIR("")

    // ss_rc_strdup(s) → RC-managed copy of string
    emitIR("define ptr @ss_rc_strdup(ptr %s) {")
    irLabel("entry")
    irCall("len", "i64", "strlen", "ptr %s")
    irAdd("size", "i64", "%len", "1")
    irCall("buf", "ptr", "ss_rc_alloc", "i64 %size, i32 0")
    irCall("_1", "ptr", "memcpy", "ptr %buf, ptr %s, i64 %size")
    irRet("ptr", "%buf")
    emitIR("}")
    emitIR("")

    // ss_rc_retain(p) — increment rc; skip null, non-RC, and immortal (rc<0)
    emitIR("define void @ss_rc_retain(ptr %p) {")
    irLabel("entry")
    irICmp("isnull", "eq", "ptr", "%p", "null")
    irBrCond("isnull", "done", "guard")
    irLabel("guard")
    irGEP("magp", "i8", "%p", "-4")
    irLoad("mag", "i32", "%magp")
    irICmp("isrc", "eq", "i32", "%mag", "1397969747")
    irBrCond("isrc", "check", "done")
    irLabel("check")
    irGEP("raw", "i8", "%p", "-16")
    irLoad("rc", "i64", "%raw")
    irICmp("immortal", "slt", "i64", "%rc", "0")
    irBrCond("immortal", "done", "inc")
    irLabel("inc")
    irAdd("rc1", "i64", "%rc", "1")
    irStore("i64", "%rc1", "%raw")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_rc_release(p) — decrement rc; free when 0; skip null, non-RC, and immortal
    // On rc=0: dispatch to type-specific destructor based on tag before freeing
    emitIR("define void @ss_rc_release(ptr %p) {")
    irLabel("entry")
    irICmp("isnull", "eq", "ptr", "%p", "null")
    irBrCond("isnull", "done", "guard")
    irLabel("guard")
    irGEP("magp", "i8", "%p", "-4")
    irLoad("mag", "i32", "%magp")
    irICmp("isrc", "eq", "i32", "%mag", "1397969747")
    irBrCond("isrc", "check", "done")
    irLabel("check")
    irGEP("raw", "i8", "%p", "-16")
    irLoad("rc", "i64", "%raw")
    irICmp("immortal", "slt", "i64", "%rc", "0")
    irBrCond("immortal", "done", "dec")
    irLabel("dec")
    irSub("rc1", "i64", "%rc", "1")
    irICmp("iszero", "eq", "i64", "%rc1", "0")
    irBrCond("iszero", "destroy", "store")
    irLabel("store")
    irStore("i64", "%rc1", "%raw")
    irBr("done")
    irLabel("destroy")
    emitIR("  ; Dispatch destructor by tag")
    irGEP("tagp", "i8", "%p", "-8")
    irLoad("tag", "i32", "%tagp")
    irICmp("is_map", "eq", "i32", "%tag", "2")
    irBrCond("is_map", "dtor_map", "check_arr")
    irLabel("check_arr")
    irICmp("is_arr", "eq", "i32", "%tag", "1")
    irBrCond("is_arr", "dtor_arr", "check_arrptr")
    irLabel("check_arrptr")
    irICmp("is_arrptr", "eq", "i32", "%tag", "5")
    irBrCond("is_arrptr", "dtor_arrptr", "check_class")
    irLabel("check_class")
    irICmp("is_class_dtor", "sge", "i32", "%tag", "10")
    irBrCond("is_class_dtor", "dtor_class", "do_free")
    irLabel("dtor_arr")
    irCallVoid("ss_rc_free_array_data", "ptr %p")
    irBr("do_free")
    irLabel("dtor_map")
    irCallVoid("ss_rc_destroy_map", "ptr %p")
    irBr("do_free")
    irLabel("dtor_arrptr")
    irCallVoid("ss_rc_destroy_array_ptrs", "ptr %p")
    irBr("do_free")
    irLabel("dtor_class")
    irSub("didx", "i32", "%tag", "10")
    irSext("didx64", "i32", "%didx", "i64")
    emitIR("  %dgep = getelementptr [100 x ptr], ptr @ss_class_dtor, i64 0, i64 %didx64")
    irLoad("dfn", "ptr", "%dgep")
    irICmp("has_dtor", "ne", "ptr", "%dfn", "null")
    irBrCond("has_dtor", "call_dtor", "do_free")
    irLabel("call_dtor")
    emitIR("  call void %dfn(ptr %p)")
    irBr("do_free")
    irLabel("do_free")
    irCallVoid("free", "ptr %raw")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_rc_release_no_children(p) — decrement rc; if zero, free without destructor/element cleanup
    // Used for non-owning container fields: the container is freed but elements are not released
    emitIR("define void @ss_rc_release_no_children(ptr %p) {")
    irLabel("entry")
    irICmp("isnull", "eq", "ptr", "%p", "null")
    irBrCond("isnull", "done", "guard")
    irLabel("guard")
    irGEP("magp", "i8", "%p", "-4")
    irLoad("mag", "i32", "%magp")
    irICmp("isrc", "eq", "i32", "%mag", "1397969747")
    irBrCond("isrc", "check", "done")
    irLabel("check")
    irGEP("raw", "i8", "%p", "-16")
    irLoad("rc", "i64", "%raw")
    irICmp("immortal", "slt", "i64", "%rc", "0")
    irBrCond("immortal", "done", "dec")
    irLabel("dec")
    irSub("rc1", "i64", "%rc", "1")
    irICmp("iszero", "eq", "i64", "%rc1", "0")
    irBrCond("iszero", "do_free", "store")
    irLabel("store")
    irStore("i64", "%rc1", "%raw")
    irBr("done")
    irLabel("do_free")
    irCallVoid("free", "ptr %raw")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_rc_destroy_map(map) — release all keys, optionally release ptr values, free entries
    // val_type flag at map offset 516: 0=scalar values, 1=ptr values (need release)
    emitIR("define void @ss_rc_destroy_map(ptr %map) {")
    irLabel("entry")
    irAlloca("ia", "i64", 8)
    irAlloca("ea", "ptr", 8)
    irAlloca("na", "ptr", 8)
    irGEP("vtpp", "i8", "%map", "516")
    irLoad("vtp", "i32", "%vtpp")
    irICmp("val_is_ptr", "eq", "i32", "%vtp", "1")
    irStore("i64", "0", "%ia")
    irBr("bucket.loop")
    irLabel("bucket.loop")
    irLoad("i", "i64", "%ia")
    irICmp("done", "eq", "i64", "%i", "64")
    irBrCond("done", "ret", "bucket.body")
    irLabel("bucket.body")
    irGEP("bp", "ptr", "%map", "%i")
    irLoad("e0", "ptr", "%bp")
    irStore("ptr", "%e0", "%ea")
    irBr("entry.loop")
    irLabel("entry.loop")
    irLoad("e", "ptr", "%ea")
    irICmp("enull", "eq", "ptr", "%e", "null")
    irBrCond("enull", "bucket.next", "entry.body")
    irLabel("entry.body")
    emitIR("  ; Save next pointer before freeing")
    irGEP("enp", "i8", "%e", "16")
    irLoad("next", "ptr", "%enp")
    irStore("ptr", "%next", "%na")
    emitIR("  ; Release key (RC string)")
    irLoad("key", "ptr", "%e")
    irCallVoid("ss_rc_release", "ptr %key")
    emitIR("  ; Release value if map has ptr values")
    irBrCond("val_is_ptr", "rel.val", "free.entry")
    irLabel("rel.val")
    irGEP("vp2", "i8", "%e", "8")
    irLoad("vi", "i64", "%vp2")
    irIntToPtr("vptr", "i64", "%vi")
    irCallVoid("ss_rc_release", "ptr %vptr")
    irBr("free.entry")
    irLabel("free.entry")
    emitIR("  ; Free entry node (plain malloc)")
    irCallVoid("free", "ptr %e")
    emitIR("  ; Advance to next entry")
    irLoad("nv", "ptr", "%na")
    irStore("ptr", "%nv", "%ea")
    irBr("entry.loop")
    irLabel("bucket.next")
    irLoad("ni", "i64", "%ia")
    irAdd("ni1", "i64", "%ni", "1")
    irStore("i64", "%ni1", "%ia")
    irBr("bucket.loop")
    irLabel("ret")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_rc_free_array_data(arr) — free the data buffer
    emitIR("define void @ss_rc_free_array_data(ptr %arr) {")
    irLabel("entry")
    irGEP("datap", "i64", "%arr", "2")
    irLoad("data_i", "i64", "%datap")
    irICmp("has_data", "ne", "i64", "%data_i", "0")
    irBrCond("has_data", "free_it", "ret")
    irLabel("free_it")
    irIntToPtr("data", "i64", "%data_i")
    irCallVoid("free", "ptr %data")
    irBr("ret")
    irLabel("ret")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_rc_destroy_array_ptrs(arr) — release all ptr elements + free data buffer
    emitIR("define void @ss_rc_destroy_array_ptrs(ptr %arr) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irLoadArrayData("data", "%arr")
    irICmp("has_data", "ne", "ptr", "%data", "null")
    irBrCond("has_data", "release_elems", "ret")
    irLabel("release_elems")
    irAlloca("ia", "i64", 8)
    irStore("i64", "0", "%ia")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%ia")
    irICmp("done", "eq", "i64", "%ci", "%len")
    irBrCond("done", "free_data", "body")
    irLabel("body")
    irGEP("ep", "i64", "%data", "%ci")
    irLoad("ev", "i64", "%ep")
    irIntToPtr("eptr", "i64", "%ev")
    irCallVoid("ss_rc_release", "ptr %eptr")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%ia")
    irBr("loop")
    irLabel("free_data")
    irCallVoid("ss_rc_free_array_data", "ptr %arr")
    irBr("ret")
    irLabel("ret")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_rc_atexit_cleanup — stub for program exit cleanup (future cycle cleanup)
    emitIR("define void @ss_rc_atexit_cleanup() {")
    irLabel("entry")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ── New class-instance RC (in-struct rc at offset 0, TypeInfo at offset 1) ──

    // ss_retain(ptr) — increment i64 rc at struct offset 0; D168 §B.3 immortal (rc<0) 跳过
    emitIR("define void @ss_retain(ptr %p) {")
    irLabel("entry")
    irICmp("isnull", "eq", "ptr", "%p", "null")
    irBrCond("isnull", "done", "load")
    irLabel("load")
    emitIR("  %rc_ptr = getelementptr %ObjHeader, ptr %p, i32 0, i32 0")
    irLoad("rc", "i64", "%rc_ptr")
    irICmp("immortal", "slt", "i64", "%rc", "0")
    irBrCond("immortal", "done", "inc")
    irLabel("inc")
    irAdd("rc1", "i64", "%rc", "1")
    irStore("i64", "%rc1", "%rc_ptr")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_release(ptr) — decrement i64 rc; if 0 call drop via TypeInfo; D168 §B.3 immortal (rc<0) 跳过
    emitIR("define void @ss_release(ptr %p) {")
    irLabel("entry")
    irICmp("isnull", "eq", "ptr", "%p", "null")
    irBrCond("isnull", "done", "load")
    irLabel("load")
    emitIR("  %rc_ptr = getelementptr %ObjHeader, ptr %p, i32 0, i32 0")
    irLoad("rc", "i64", "%rc_ptr")
    irICmp("immortal", "slt", "i64", "%rc", "0")
    irBrCond("immortal", "done", "dec")
    irLabel("dec")
    irSub("rc1", "i64", "%rc", "1")
    irICmp("iszero", "eq", "i64", "%rc1", "0")
    irBrCond("iszero", "drop", "store")
    irLabel("store")
    irStore("i64", "%rc1", "%rc_ptr")
    irBr("done")
    irLabel("drop")
    // Write rc=0 before calling drop to prevent reentrant double-free
    irStore("i64", "0", "%rc_ptr")
    emitIR("  %ti_ptr = getelementptr %ObjHeader, ptr %p, i32 0, i32 1")
    irLoad("ti", "ptr", "%ti_ptr")
    emitIR("  %drop_fn_ptr = getelementptr %TypeInfo, ptr %ti, i32 0, i32 0")
    irLoad("drop_fn", "ptr", "%drop_fn_ptr")
    emitIR("  call void %drop_fn(ptr %p)")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_alloc(size) — allocate zeroed memory for class instance (mimalloc)
    emitIR("define ptr @ss_alloc(i64 %size) {")
    irLabel("entry")
    irCall("p", "ptr", "mi_calloc", "i64 1, i64 %size")
    irRet("ptr", "%p")
    emitIR("}")
    emitIR("")

    // ss_dealloc(ptr) — free class instance memory (mimalloc)
    emitIR("define void @ss_dealloc(ptr %p) {")
    irLabel("entry")
    irCallVoid("mi_free", "ptr %p")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // D168 §B.5: 内置 String 类型 TypeInfo + per-type 函数
    // P1.2 dead-code 元数据;P1.3 连接到字面量发射 + dispatch 路由
    emitStringTypeInfo()
}

// D168 §B.5: %String = { i64 rc, ptr TypeInfo, ptr buffer, i64 len, i64 cap } 间接 buffer 布局
// String immutable: shallow_clone = ss_retain self (零拷贝);deep_clone = 复制 buffer
function emitStringTypeInfo() {
    // %String struct type — 5 字段间接 buffer 布局,40 字节
    emitIR("%String = type { i64, ptr, ptr, i64, i64 }")
    emitIR("")

    // 类型名常量
    emitIR("@.rt.str.String = private constant [7 x i8] c\"String\\00\"")
    emitIR("")

    // ss_drop_String — free buffer + ss_dealloc self
    emitIR("define void @ss_drop_String(ptr %p) {")
    emitIR("entry:")
    emitIR("  %buf_ptr = getelementptr %String, ptr %p, i32 0, i32 2")
    emitIR("  %buf = load ptr, ptr %buf_ptr, align 8")
    emitIR("  call void @mi_free(ptr %buf)")
    emitIR("  call void @ss_dealloc(ptr %p)")
    emitIR("  ret void")
    emitIR("}")
    emitIR("")

    // ss_deep_clone_String — mi_calloc 新 header + 新 buffer + memcpy bytes
    emitIR("define ptr @ss_deep_clone_String(ptr %p) {")
    emitIR("entry:")
    emitIR("  %new_header = call ptr @mi_calloc(i64 1, i64 ptrtoint (ptr getelementptr (%String, ptr null, i32 1) to i64))")
    emitIR("  %src_buf_ptr = getelementptr %String, ptr %p, i32 0, i32 2")
    emitIR("  %src_buf = load ptr, ptr %src_buf_ptr, align 8")
    emitIR("  %src_len_ptr = getelementptr %String, ptr %p, i32 0, i32 3")
    emitIR("  %src_len = load i64, ptr %src_len_ptr, align 8")
    emitIR("  %src_cap_ptr = getelementptr %String, ptr %p, i32 0, i32 4")
    emitIR("  %src_cap = load i64, ptr %src_cap_ptr, align 8")
    emitIR("  %new_buf = call ptr @mi_calloc(i64 1, i64 %src_cap)")
    emitIR("  %_mc = call ptr @memcpy(ptr %new_buf, ptr %src_buf, i64 %src_len)")
    emitIR("  %new_rc_ptr = getelementptr %String, ptr %new_header, i32 0, i32 0")
    emitIR("  store i64 1, ptr %new_rc_ptr, align 8")
    emitIR("  %new_ti_ptr = getelementptr %String, ptr %new_header, i32 0, i32 1")
    emitIR("  store ptr @String_type_info, ptr %new_ti_ptr, align 8")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new_header, i32 0, i32 2")
    emitIR("  store ptr %new_buf, ptr %new_buf_ptr, align 8")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new_header, i32 0, i32 3")
    emitIR("  store i64 %src_len, ptr %new_len_ptr, align 8")
    emitIR("  %new_cap_ptr = getelementptr %String, ptr %new_header, i32 0, i32 4")
    emitIR("  store i64 %src_cap, ptr %new_cap_ptr, align 8")
    emitIR("  ret ptr %new_header")
    emitIR("}")
    emitIR("")

    // ss_shallow_clone_String — String immutable: retain self + return self
    emitIR("define ptr @ss_shallow_clone_String(ptr %p) {")
    emitIR("entry:")
    emitIR("  call void @ss_retain(ptr %p)")
    emitIR("  ret ptr %p")
    emitIR("}")
    emitIR("")

    // @String_type_info 常量(class_id=-1 表非用户 class,parent=null)
    emitIR("@String_type_info = constant %TypeInfo {")
    emitIR("  ptr @ss_drop_String,")
    emitIR("  ptr @ss_deep_clone_String,")
    emitIR("  ptr @ss_shallow_clone_String,")
    emitIR("  i64 ptrtoint (ptr getelementptr (%String, ptr null, i32 1) to i64),")
    emitIR("  ptr @.rt.str.String,")
    emitIR("  i32 -1,")
    emitIR("  ptr null")
    emitIR("}")
    emitIR("")
}

// ── D079: Test framework runtime ─────────────────────────────

function emitRuntimeTestFramework() {
    // ss_test_summary — called via atexit, prints pass/fail/total and exits 1 on failure
    emitIR("define void @ss_test_summary() {")
    emitIR("entry:")
    emitIR("  %total = load i32, ptr @ss_test_total, align 4")
    emitIR("  %no_tests = icmp eq i32 %total, 0")
    emitIR("  br i1 %no_tests, label %skip, label %report")
    emitIR("report:")
    // Print newline
    emitIR("  %nl = call i32 (ptr, ...) @printf(ptr @.rt.str.nl)")
    // Print "Tests: <passed> passed, <failed> failed, <total> total"
    emitIR("  %passed = load i32, ptr @ss_test_passed, align 4")
    emitIR("  %failed = load i32, ptr @ss_test_failed, align 4")
    // Build summary: "Tests: "
    emitIR("  %p1 = call i32 (ptr, ...) @printf(ptr @.rt.str.test_summary1)")
    // passed count
    emitIR("  %p2 = call i32 (ptr, ...) @printf(ptr @.rt.fmt.d, i32 %passed)")
    emitIR("  %p3 = call i32 (ptr, ...) @printf(ptr @.rt.str.test_passed)")
    // failed count
    emitIR("  %p4 = call i32 (ptr, ...) @printf(ptr @.rt.fmt.d, i32 %failed)")
    emitIR("  %p5 = call i32 (ptr, ...) @printf(ptr @.rt.str.test_failed)")
    // total count
    emitIR("  %p6 = call i32 (ptr, ...) @printf(ptr @.rt.fmt.d, i32 %total)")
    emitIR("  %p7 = call i32 (ptr, ...) @printf(ptr @.rt.str.test_total)")
    emitIR("  %p8 = call i32 (ptr, ...) @printf(ptr @.rt.str.nl)")
    // Flush stdout
    emitIR("  %stdout_ptr = load ptr, ptr @stdout, align 8")
    emitIR("  %ff = call i32 @fflush(ptr %stdout_ptr)")
    // Exit 1 if any failures
    emitIR("  %has_fail = icmp sgt i32 %failed, 0")
    emitIR("  br i1 %has_fail, label %exit_fail, label %exit_ok")
    emitIR("exit_fail:")
    emitIR("  call void @exit(i32 1)")
    emitIR("  unreachable")
    emitIR("exit_ok:")
    emitIR("  ret void")
    emitIR("skip:")
    emitIR("  ret void")
    emitIR("}")
    emitIR("")
}
