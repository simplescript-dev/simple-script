// gen_rt_string.ss — Runtime string operations and type conversions
// D168 §B.7 / B.4: All string runtime functions take/return %String header ptr (boxed)
// Header layout: { i64 rc, ptr TypeInfo, ptr buffer, i64 len, i64 cap }

// ── String operations ─────────────────────────────────────────

function emitRuntimeStringOps() {
    // ss_stringLength — 读 String header.len 字段
    emitIR("define i32 @ss_stringLength(ptr %s) {")
    emitIR("  %len_ptr = getelementptr %String, ptr %s, i32 0, i32 3")
    emitIR("  %len = load i64, ptr %len_ptr, align 8")
    irTrunc("result", "i64", "%len", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_string_concat — 取双方 buffer + len,合并到新 String header
    emitIR("define ptr @ss_string_concat(ptr %a, ptr %b) {")
    emitIR("  %a_buf_ptr = getelementptr %String, ptr %a, i32 0, i32 2")
    emitIR("  %a_buf = load ptr, ptr %a_buf_ptr, align 8")
    emitIR("  %a_len_ptr = getelementptr %String, ptr %a, i32 0, i32 3")
    emitIR("  %a_len = load i64, ptr %a_len_ptr, align 8")
    emitIR("  %b_buf_ptr = getelementptr %String, ptr %b, i32 0, i32 2")
    emitIR("  %b_buf = load ptr, ptr %b_buf_ptr, align 8")
    emitIR("  %b_len_ptr = getelementptr %String, ptr %b, i32 0, i32 3")
    emitIR("  %b_len = load i64, ptr %b_len_ptr, align 8")
    irAdd("total", "i64", "%a_len", "%b_len")
    irAdd("size", "i64", "%total", "1")
    irCall("new", "ptr", "ss_alloc_string", "i64 %size")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irCall("_1", "ptr", "memcpy", "ptr %new_buf, ptr %a_buf, i64 %a_len")
    irGEP("dst", "i8", "%new_buf", "%a_len")
    irAdd("blen1", "i64", "%b_len", "1")
    irCall("_2", "ptr", "memcpy", "ptr %dst, ptr %b_buf, i64 %blen1")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 %total, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_string_eq
    emitIR("define i32 @ss_string_eq(ptr %a, ptr %b) {")
    emitIR("  %a_buf_ptr = getelementptr %String, ptr %a, i32 0, i32 2")
    emitIR("  %a_buf = load ptr, ptr %a_buf_ptr, align 8")
    emitIR("  %b_buf_ptr = getelementptr %String, ptr %b, i32 0, i32 2")
    emitIR("  %b_buf = load ptr, ptr %b_buf_ptr, align 8")
    irCall("cmp", "i32", "strcmp", "ptr %a_buf, ptr %b_buf")
    irICmp("iseq", "eq", "i32", "%cmp", "0")
    irZext("result", "i1", "%iseq", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_string_ne
    emitIR("define i32 @ss_string_ne(ptr %a, ptr %b) {")
    emitIR("  %a_buf_ptr = getelementptr %String, ptr %a, i32 0, i32 2")
    emitIR("  %a_buf = load ptr, ptr %a_buf_ptr, align 8")
    emitIR("  %b_buf_ptr = getelementptr %String, ptr %b, i32 0, i32 2")
    emitIR("  %b_buf = load ptr, ptr %b_buf_ptr, align 8")
    irCall("cmp", "i32", "strcmp", "ptr %a_buf, ptr %b_buf")
    irICmp("isne", "ne", "i32", "%cmp", "0")
    irZext("result", "i1", "%isne", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_strcmp
    emitIR("define i32 @ss_strcmp(ptr %a, ptr %b) {")
    emitIR("  %a_buf_ptr = getelementptr %String, ptr %a, i32 0, i32 2")
    emitIR("  %a_buf = load ptr, ptr %a_buf_ptr, align 8")
    emitIR("  %b_buf_ptr = getelementptr %String, ptr %b, i32 0, i32 2")
    emitIR("  %b_buf = load ptr, ptr %b_buf_ptr, align 8")
    irCall("result", "i32", "strcmp", "ptr %a_buf, ptr %b_buf")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_indexOf — 取双方 buffer + strstr,offset 相对 a buffer
    emitIR("define i32 @ss_indexOf(ptr %s, ptr %sub) {")
    irLabel("entry")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    emitIR("  %sub_buf_ptr = getelementptr %String, ptr %sub, i32 0, i32 2")
    emitIR("  %sub_buf = load ptr, ptr %sub_buf_ptr, align 8")
    irCall("found", "ptr", "strstr", "ptr %s_buf, ptr %sub_buf")
    irICmp("isnull", "eq", "ptr", "%found", "null")
    irBrCond("isnull", "neg", "pos")
    irLabel("neg")
    irRet("i32", "-1")
    irLabel("pos")
    irPtrToInt("faddr", "%found", "i64")
    irPtrToInt("saddr", "%s_buf", "i64")
    irSub("diff", "i64", "%faddr", "%saddr")
    irTrunc("result", "i64", "%diff", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_charAt — 取 s.buffer[idx],返回新单字符 String
    emitIR("define ptr @ss_charAt(ptr %s, i32 %idx) {")
    irLabel("entry")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    emitIR("  %s_len_ptr = getelementptr %String, ptr %s, i32 0, i32 3")
    emitIR("  %len = load i64, ptr %s_len_ptr, align 8")
    irSext("idx64", "i32", "%idx", "i64")
    irICmp("oob", "sge", "i64", "%idx64", "%len")
    irBrCond("oob", "oob_ret", "ok")
    irLabel("oob_ret")
    irCall("empty", "ptr", "ss_string_from_cstr", "ptr @.rt.str.empty")
    irRet("ptr", "%empty")
    irLabel("ok")
    irCall("new", "ptr", "ss_alloc_string", "i64 2")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irGEP("cp", "i8", "%s_buf", "%idx64")
    irLoad("ch", "i8", "%cp")
    irStore("i8", "%ch", "%new_buf")
    irGEP("term", "i8", "%new_buf", "1")
    irStore("i8", "0", "%term")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 1, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_substring
    emitIR("define ptr @ss_substring(ptr %s, i32 %start, i32 %count) {")
    irLabel("entry")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    emitIR("  %s_len_ptr = getelementptr %String, ptr %s, i32 0, i32 3")
    emitIR("  %len = load i64, ptr %s_len_ptr, align 8")
    irSext("start64", "i32", "%start", "i64")
    irSext("count64", "i32", "%count", "i64")
    irICmp("neg", "slt", "i64", "%start64", "0")
    irSelect("clamped_start", "neg", "i64", "0", "%start64")
    irICmp("past_end", "sgt", "i64", "%clamped_start", "%len")
    irSelect("safe_start", "past_end", "i64", "%len", "%clamped_start")
    irAdd("end_pos", "i64", "%safe_start", "%count64")
    irICmp("overflow", "sgt", "i64", "%end_pos", "%len")
    irSub("remaining", "i64", "%len", "%safe_start")
    irSelect("safe_count", "overflow", "i64", "%remaining", "%count64")
    irAdd("alloc", "i64", "%safe_count", "1")
    irCall("new", "ptr", "ss_alloc_string", "i64 %alloc")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irGEP("src", "i8", "%s_buf", "%safe_start")
    irCall("_1", "ptr", "memcpy", "ptr %new_buf, ptr %src, i64 %safe_count")
    irGEP("term", "i8", "%new_buf", "%safe_count")
    irStore("i8", "0", "%term")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 %safe_count, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_charCodeAt
    emitIR("define i32 @ss_charCodeAt(ptr %s, i32 %idx) {")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    irSext("idx64", "i32", "%idx", "i64")
    irGEP("cp", "i8", "%s_buf", "%idx64")
    irLoad("ch", "i8", "%cp")
    irZext("result", "i8", "%ch", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_fromCharCode — 创建单字符 String
    emitIR("define ptr @ss_fromCharCode(i32 %code) {")
    irCall("new", "ptr", "ss_alloc_string", "i64 2")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irTrunc("ch", "i32", "%code", "i8")
    irStore("i8", "%ch", "%new_buf")
    irGEP("term", "i8", "%new_buf", "1")
    irStore("i8", "0", "%term")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 1, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_split — two pass: count then extract;入参 String header,返回 Array<string>(每元素是 String header ptr)
    emitIR("define ptr @ss_split(ptr %s, ptr %delim) {")
    irLabel("entry")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    emitIR("  %d_buf_ptr = getelementptr %String, ptr %delim, i32 0, i32 2")
    emitIR("  %d_buf = load ptr, ptr %d_buf_ptr, align 8")
    irCall("dlen", "i64", "strlen", "ptr %d_buf")
    irCall("slen", "i64", "strlen", "ptr %s_buf")
    emitIR("  ; Count pass")
    irAlloca("cnt", "i32", 4)
    irStore("i32", "1", "%cnt")
    irAlloca("p1", "ptr", 8)
    irStore("ptr", "%s_buf", "%p1")
    irICmp("is_empty_d", "eq", "i64", "%dlen", "0")
    irBrCond("is_empty_d", "build", "count.loop")
    irLabel("count.loop")
    irLoad("cp", "ptr", "%p1")
    irCall("found", "ptr", "strstr", "ptr %cp, ptr %d_buf")
    irICmp("nf", "eq", "ptr", "%found", "null")
    irBrCond("nf", "build", "count.inc")
    irLabel("count.inc")
    irLoad("cc", "i32", "%cnt")
    irAdd("cc1", "i32", "%cc", "1")
    irStore("i32", "%cc1", "%cnt")
    irGEP("np", "i8", "%found", "%dlen")
    irStore("ptr", "%np", "%p1")
    irBr("count.loop")
    irLabel("build")
    irLoad("n", "i32", "%cnt")
    irCall("arr", "ptr", "ss_newArrayPtr", "i32 %n")
    emitIR("  ; Extract pass")
    irAlloca("idx", "i32", 4)
    irStore("i32", "0", "%idx")
    irStore("ptr", "%s_buf", "%p1")
    irBrCond("is_empty_d", "single", "ext.loop")
    irLabel("single")
    irCall("dup0", "ptr", "ss_string_from_cstr", "ptr %s_buf")
    irPtrToInt("dup0i", "%dup0", "i64")
    irCallVoid("ss_arraySet", "ptr %arr, i32 0, i64 %dup0i")
    irRet("ptr", "%arr")
    irLabel("ext.loop")
    irLoad("ep", "ptr", "%p1")
    irCall("ef", "ptr", "strstr", "ptr %ep, ptr %d_buf")
    irICmp("enf", "eq", "ptr", "%ef", "null")
    irBrCond("enf", "ext.last", "ext.copy")
    irLabel("ext.copy")
    irPtrToInt("elen", "%ef", "i64")
    irPtrToInt("estart", "%ep", "i64")
    irSub("epartlen", "i64", "%elen", "%estart")
    irAdd("ealloc", "i64", "%epartlen", "1")
    irCall("estr", "ptr", "ss_alloc_string", "i64 %ealloc")
    emitIR("  %estr_buf_ptr = getelementptr %String, ptr %estr, i32 0, i32 2")
    emitIR("  %estr_buf = load ptr, ptr %estr_buf_ptr, align 8")
    irCall("_1", "ptr", "memcpy", "ptr %estr_buf, ptr %ep, i64 %epartlen")
    irGEP("eterm", "i8", "%estr_buf", "%epartlen")
    irStore("i8", "0", "%eterm")
    emitIR("  %estr_len_ptr = getelementptr %String, ptr %estr, i32 0, i32 3")
    emitIR("  store i64 %epartlen, ptr %estr_len_ptr, align 8")
    irLoad("ei", "i32", "%idx")
    irPtrToInt("estri", "%estr", "i64")
    irCallVoid("ss_arraySet", "ptr %arr, i32 %ei, i64 %estri")
    irAdd("ei1", "i32", "%ei", "1")
    irStore("i32", "%ei1", "%idx")
    irGEP("enp", "i8", "%ef", "%dlen")
    irStore("ptr", "%enp", "%p1")
    irBr("ext.loop")
    irLabel("ext.last")
    irCall("ldup", "ptr", "ss_string_from_cstr", "ptr %ep")
    irLoad("li", "i32", "%idx")
    irPtrToInt("ldupi", "%ldup", "i64")
    irCallVoid("ss_arraySet", "ptr %arr, i32 %li, i64 %ldupi")
    irRet("ptr", "%arr")
    emitIR("}")
    emitIR("")
}

// ── Type conversions ──────────────────────────────────────────

function emitRuntimeConversions() {
    // ss_int_to_string — snprintf 到 buffer + 设 len
    emitIR("define ptr @ss_int_to_string(i32 %val) {")
    irCall("new", "ptr", "ss_alloc_string", "i64 32")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irCall("written", "i32 (ptr, i64, ptr, ...)", "snprintf", "ptr %new_buf, i64 32, ptr @.rt.fmt.d, i32 %val")
    irSext("written64", "i32", "%written", "i64")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 %written64, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_double_to_string
    emitIR("define ptr @ss_double_to_string(double %val) {")
    irCall("new", "ptr", "ss_alloc_string", "i64 64")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irCall("written", "i32 (ptr, i64, ptr, ...)", "snprintf", "ptr %new_buf, i64 64, ptr @.rt.fmt.g, double %val")
    irSext("written64", "i32", "%written", "i64")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 %written64, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_bool_to_string — 包装 @.rt.str.true/.false 为新 String(每次返回新对象,immortal 可后期优化)
    emitIR("define ptr @ss_bool_to_string(i32 %val) {")
    irICmp("nonzero", "ne", "i32", "%val", "0")
    irBrCond("nonzero", "tt", "ff")
    irLabel("tt")
    irCall("trueStr", "ptr", "ss_string_from_cstr", "ptr @.rt.str.true")
    irRet("ptr", "%trueStr")
    irLabel("ff")
    irCall("falseStr", "ptr", "ss_string_from_cstr", "ptr @.rt.str.false")
    irRet("ptr", "%falseStr")
    emitIR("}")
    emitIR("")

    // ss_i64_to_string — always format as i64 integer
    emitIR("define ptr @ss_i64_to_string(i64 %val) {")
    irLabel("entry")
    irCall("new", "ptr", "ss_alloc_string", "i64 32")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irCall("written", "i32 (ptr, i64, ptr, ...)", "snprintf", "ptr %new_buf, i64 32, ptr @.rt.fmt.lld, i64 %val")
    irSext("written64", "i32", "%written", "i64")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 %written64, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_parseInt — 取 buffer 后 atoi
    emitIR("define i32 @ss_parseInt(ptr %s) {")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    irCall("result", "i32", "atoi", "ptr %s_buf")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_parseDouble — 取 buffer 后 atof
    emitIR("define double @ss_parseDouble(ptr %s) {")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    irCall("result", "double", "atof", "ptr %s_buf")
    irRet("double", "%result")
    emitIR("}")
    emitIR("")

    // ss_doubleBits — IEEE 754 binary repr (D098 §决策 2 §Phase C InternPool key)
    // bitcast double → i64 + snprintf "%016llx" → 16-char hex String
    emitIR("define ptr @ss_doubleBits(double %d) {")
    irLabel("entry")
    irCall("new", "ptr", "ss_alloc_string", "i64 32")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    emitIR("  %bits = bitcast double %d to i64")
    irCall("written", "i32 (ptr, i64, ptr, ...)", "snprintf", "ptr %new_buf, i64 32, ptr @.rt.fmt.hex16, i64 %bits")
    irSext("written64", "i32", "%written", "i64")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 %written64, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    emitIR("}")
    emitIR("")

    // ss_bitsToDouble — IEEE 754 hex16 → double(ss_doubleBits 逆;D171 chained comptime double
    // 算术 exact 回读)。strtoull(buf, NULL, 16) → i64 → bitcast double,与 ss_doubleBits 完全互逆,
    // 单 op exact-bits 不退化。签名形状同 ss_parseDouble(ptr→double),仅 body 走精确位非 atof 十进制。
    emitIR("define double @ss_bitsToDouble(ptr %s) {")
    irLabel("entry")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    irCall("bits", "i64", "strtoull", "ptr %s_buf, ptr null, i32 16")
    emitIR("  %d = bitcast i64 %bits to double")
    irRet("double", "%d")
    emitIR("}")
    emitIR("")
}
