// gen_rt_io.ss — Runtime I/O, process, and math operations

// ── I/O ───────────────────────────────────────────────────────

function emitRuntimeIO() {
    // ss_println — D168 §B.7: %s 是 SS String header,GEP buffer 给 puts
    emitIR("define void @ss_println(ptr %s) {")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    irCall("_1", "i32", "puts", "ptr %s_buf")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_print — D168 §B.7: %s 是 SS String header,GEP buffer 给 fputs
    emitIR("define void @ss_print(ptr %s) {")
    emitIR("  %s_buf_ptr = getelementptr %String, ptr %s, i32 0, i32 2")
    emitIR("  %s_buf = load ptr, ptr %s_buf_ptr, align 8")
    irLoad("out", "ptr", "@stdout")
    irCall("_1", "i32", "fputs", "ptr %s_buf, ptr %out")
    irLoad("out2", "ptr", "@stdout")
    irCall("_2", "i32", "fflush", "ptr %out2")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_readLine — dynamic buffer, reads lines of any length
    emitIR("define ptr @ss_readLine() {")
    irLabel("entry")
    irAlloca("bufp", "ptr", 8)
    irAlloca("cap", "i64", 8)
    irAlloca("off", "i64", 8)
    irCall("r0", "ptr", "ss_rc_alloc", "i64 1024, i32 0")
    irStore("ptr", "%r0", "%bufp")
    irStore("i64", "1024", "%cap")
    irStore("i64", "0", "%off")
    irLoad("in", "ptr", "@stdin")
    irBr("read")
    irLabel("read")
    irLoad("cbuf", "ptr", "%bufp")
    irLoad("coff", "i64", "%off")
    irLoad("ccap", "i64", "%cap")
    irSub("rem", "i64", "%ccap", "%coff")
    irTrunc("remi", "i64", "%rem", "i32")
    irGEP("dst", "i8", "%cbuf", "%coff")
    irCall("result", "ptr", "fgets", "ptr %dst, i32 %remi, ptr %in")
    irICmp("isnull", "eq", "ptr", "%result", "null")
    irBrCond("isnull", "eof", "check")
    irLabel("eof")
    irLoad("eoff", "i64", "%off")
    irICmp("empty", "eq", "i64", "%eoff", "0")
    irBrCond("empty", "nil", "done")
    irLabel("nil")
    irLoad("nbuf", "ptr", "%bufp")
    irStore("i8", "0", "%nbuf")
    // D168 §B.7: 包装 byte buf → SS String header,释放原 byte buf
    irCall("nilret", "ptr", "ss_string_from_cstr", "ptr %nbuf")
    irCallVoid("ss_rc_release", "ptr %nbuf")
    irRet("ptr", "%nilret")
    irLabel("check")
    irLoad("kbuf", "ptr", "%bufp")
    irCall("total", "i64", "strlen", "ptr %kbuf")
    irICmp("haslen", "sgt", "i64", "%total", "0")
    irBrCond("haslen", "chklast", "done")
    irLabel("chklast")
    irSub("lastidx", "i64", "%total", "1")
    irGEP("lastp", "i8", "%kbuf", "%lastidx")
    irLoad("lastch", "i8", "%lastp")
    irICmp("isnl", "eq", "i8", "%lastch", "10")
    irBrCond("isnl", "strip", "chkfull")
    irLabel("strip")
    irStore("i8", "0", "%lastp")
    irBr("done")
    irLabel("chkfull")
    irLoad("kcap", "i64", "%cap")
    irSub("maxidx", "i64", "%kcap", "1")
    irICmp("isfull", "eq", "i64", "%total", "%maxidx")
    irBrCond("isfull", "grow", "done")
    irLabel("grow")
    irLoad("gcap", "i64", "%cap")
    irMul("newcap", "i64", "%gcap", "2")
    irLoad("gbuf", "ptr", "%bufp")
    irCall("newbuf", "ptr", "ss_rc_realloc", "ptr %gbuf, i64 %newcap")
    irStore("ptr", "%newbuf", "%bufp")
    irStore("i64", "%newcap", "%cap")
    irStore("i64", "%total", "%off")
    irBr("read")
    irLabel("done")
    irLoad("ret", "ptr", "%bufp")
    // D168 §B.7: 包装 byte buf → SS String header,释放原 byte buf
    irCall("retstr", "ptr", "ss_string_from_cstr", "ptr %ret")
    irCallVoid("ss_rc_release", "ptr %ret")
    irRet("ptr", "%retstr")
    emitIR("}")
    emitIR("")

    // ss_readFile — D168 §B.7: %path GEP buffer 给 fopen,返回模式 B(ss_alloc_string + 设 len)
    emitIR("define ptr @ss_readFile(ptr %path) {")
    irLabel("entry")
    emitIR("  %path_buf_ptr = getelementptr %String, ptr %path, i32 0, i32 2")
    emitIR("  %path_buf = load ptr, ptr %path_buf_ptr, align 8")
    irCall("fp", "ptr", "fopen", "ptr %path_buf, ptr @.rt.str.rb")
    irICmp("isnull", "eq", "ptr", "%fp", "null")
    irBrCond("isnull", "fail", "read")
    irLabel("read")
    irCall("_1", "i32", "fseek", "ptr %fp, i64 0, i32 2")
    irCall("size", "i64", "ftell", "ptr %fp")
    irCall("_2", "i32", "fseek", "ptr %fp, i64 0, i32 0")
    irAdd("alloc", "i64", "%size", "1")
    irCall("new", "ptr", "ss_alloc_string", "i64 %alloc")
    emitIR("  %new_buf_ptr = getelementptr %String, ptr %new, i32 0, i32 2")
    emitIR("  %new_buf = load ptr, ptr %new_buf_ptr, align 8")
    irCall("_3", "i64", "fread", "ptr %new_buf, i64 1, i64 %size, ptr %fp")
    irGEP("term", "i8", "%new_buf", "%size")
    irStore("i8", "0", "%term")
    irCall("_4", "i32", "fclose", "ptr %fp")
    emitIR("  %new_len_ptr = getelementptr %String, ptr %new, i32 0, i32 3")
    emitIR("  store i64 %size, ptr %new_len_ptr, align 8")
    irRet("ptr", "%new")
    irLabel("fail")
    irCall("empty", "ptr", "ss_string_from_cstr", "ptr @.rt.str.empty")
    irRet("ptr", "%empty")
    emitIR("}")
    emitIR("")

    // ss_writeFile — D168 §B.7: path/data 都 GEP buffer
    emitIR("define void @ss_writeFile(ptr %path, ptr %data) {")
    irLabel("entry")
    emitIR("  %path_buf_ptr = getelementptr %String, ptr %path, i32 0, i32 2")
    emitIR("  %path_buf = load ptr, ptr %path_buf_ptr, align 8")
    emitIR("  %data_buf_ptr = getelementptr %String, ptr %data, i32 0, i32 2")
    emitIR("  %data_buf = load ptr, ptr %data_buf_ptr, align 8")
    irCall("fp", "ptr", "fopen", "ptr %path_buf, ptr @.rt.str.w")
    irICmp("isnull", "eq", "ptr", "%fp", "null")
    irBrCond("isnull", "done", "wr")
    irLabel("wr")
    irCall("_1", "i32", "fputs", "ptr %data_buf, ptr %fp")
    irCall("_2", "i32", "fclose", "ptr %fp")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_appendFile — D168 §B.7: path/data 都 GEP buffer
    emitIR("define void @ss_appendFile(ptr %path, ptr %data) {")
    irLabel("entry")
    emitIR("  %path_buf_ptr = getelementptr %String, ptr %path, i32 0, i32 2")
    emitIR("  %path_buf = load ptr, ptr %path_buf_ptr, align 8")
    emitIR("  %data_buf_ptr = getelementptr %String, ptr %data, i32 0, i32 2")
    emitIR("  %data_buf = load ptr, ptr %data_buf_ptr, align 8")
    irCall("fp", "ptr", "fopen", "ptr %path_buf, ptr @.rt.str.a")
    irICmp("isnull", "eq", "ptr", "%fp", "null")
    irBrCond("isnull", "done", "wr")
    irLabel("wr")
    irCall("_1", "i32", "fputs", "ptr %data_buf, ptr %fp")
    irCall("_2", "i32", "fclose", "ptr %fp")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")
}

// ── Process ───────────────────────────────────────────────────

function emitRuntimeProcess() {
    emitIR("define void @ss_exit(i32 %code) {")
    irCallVoid("exit", "i32 %code")
    emitIR("  unreachable")
    emitIR("}")
    emitIR("")

    // ss_system — D168 §B.7: %cmd GEP buffer
    emitIR("define i32 @ss_system(ptr %cmd) {")
    emitIR("  %cmd_buf_ptr = getelementptr %String, ptr %cmd, i32 0, i32 2")
    emitIR("  %cmd_buf = load ptr, ptr %cmd_buf_ptr, align 8")
    irCall("result", "i32", "system", "ptr %cmd_buf")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    emitIR("define void @ss_initArgs(i32 %argc, ptr %argv) {")
    irStore("i32", "%argc", "@ss_argc")
    irStore("ptr", "%argv", "@ss_argv")
    irRetVoid()
    emitIR("}")
    emitIR("")

    emitIR("define i32 @ss_argCount() {")
    irLoad("count", "i32", "@ss_argc")
    irRet("i32", "%count")
    emitIR("}")
    emitIR("")

    emitIR("define ptr @ss_argGet(i32 %idx) {")
    irLabel("entry")
    irLoad("argc", "i32", "@ss_argc")
    irICmp("oob", "sge", "i32", "%idx", "%argc")
    irBrCond("oob", "oob_ret", "ok")
    irLabel("oob_ret")
    irCall("empty", "ptr", "ss_string_from_cstr", "ptr @.rt.str.empty")
    irRet("ptr", "%empty")
    irLabel("ok")
    irLoad("argv", "ptr", "@ss_argv")
    irSext("idx64", "i32", "%idx", "i64")
    irGEP("argp", "ptr", "%argv", "%idx64")
    irLoad("arg", "ptr", "%argp")
    irCall("result", "ptr", "ss_string_from_cstr", "ptr %arg")
    irRet("ptr", "%result")
    emitIR("}")
    emitIR("")

    // D080: ss_popen_read — run command via popen, capture stdout, store exit code
    // D168 §B.7: %cmd GEP buffer
    emitIR("define ptr @ss_popen_read(ptr %cmd) {")
    irLabel("entry")
    emitIR("  %cmd_buf_ptr = getelementptr %String, ptr %cmd, i32 0, i32 2")
    emitIR("  %cmd_buf = load ptr, ptr %cmd_buf_ptr, align 8")
    // popen(cmd_buf, "r")
    irCall("fp", "ptr", "popen", "ptr %cmd_buf, ptr @.rt.str.r")
    irICmp("isnull", "eq", "ptr", "%fp", "null")
    irBrCond("isnull", "fail", "init")

    // Allocate initial buffer (4096 bytes)
    irLabel("init")
    irCall("buf", "ptr", "malloc", "i64 4096")
    irStore("i8", "0", "%buf")
    emitIR("  br label %read")

    // Read loop: fread chunks into buffer, grow as needed
    irLabel("read")
    emitIR("  %pbuf = phi ptr [ %buf, %init ], [ %rbuf, %grow ], [ %pbuf2, %append ]")
    emitIR("  %poff = phi i64 [ 0, %init ], [ %goff, %grow ], [ %newoff, %append ]")
    emitIR("  %pcap = phi i64 [ 4096, %init ], [ %newcap, %grow ], [ %pcap2, %append ]")
    // remaining = cap - off - 1
    irSub("rem0", "i64", "%pcap", "%poff")
    irSub("rem", "i64", "%rem0", "1")
    irGEP("dst", "i8", "%pbuf", "%poff")
    irCall("n", "i64", "fread", "ptr %dst, i64 1, i64 %rem, ptr %fp")
    irICmp("eof", "eq", "i64", "%n", "0")
    irBrCond("eof", "done", "append")

    // Append: advance offset, null-terminate, check if full
    irLabel("append")
    emitIR("  %pbuf2 = phi ptr [ %pbuf, %read ]")
    emitIR("  %pcap2 = phi i64 [ %pcap, %read ]")
    irAdd("newoff", "i64", "%poff", "%n")
    irGEP("term", "i8", "%pbuf2", "%newoff")
    irStore("i8", "0", "%term")
    // If we filled the buffer (n == rem), grow
    irICmp("full", "eq", "i64", "%n", "%rem")
    irBrCond("full", "grow", "read")

    // Grow buffer: double capacity
    irLabel("grow")
    emitIR("  %goff = phi i64 [ %newoff, %append ]")
    emitIR("  %gbuf = phi ptr [ %pbuf2, %append ]")
    emitIR("  %gcap = phi i64 [ %pcap2, %append ]")
    irMul("newcap", "i64", "%gcap", "2")
    irCall("rbuf", "ptr", "realloc", "ptr %gbuf, i64 %newcap")
    emitIR("  br label %read")

    // Done: pclose, extract exit code, copy to RC string
    irLabel("done")
    irCall("status", "i32", "pclose", "ptr %fp")
    // WEXITSTATUS: (status >> 8) & 0xFF
    emitIR("  %shifted = lshr i32 %status, 8")
    emitIR("  %code = and i32 %shifted, 255")
    irStore("i32", "%code", "@ss_last_exit_code")
    // Copy to RC-managed string
    irCall("result", "ptr", "ss_string_from_cstr", "ptr %pbuf")
    irCallVoid("free", "ptr %pbuf")
    irRet("ptr", "%result")

    // Fail: popen returned null
    irLabel("fail")
    irStore("i32", "-1", "@ss_last_exit_code")
    irCall("empty", "ptr", "ss_string_from_cstr", "ptr @.rt.str.empty")
    irRet("ptr", "%empty")
    emitIR("}")
    emitIR("")

    // ss_getenv — D168 §B.7: %name GEP buffer
    emitIR("define ptr @ss_getenv(ptr %name) {")
    irLabel("entry")
    emitIR("  %name_buf_ptr = getelementptr %String, ptr %name, i32 0, i32 2")
    emitIR("  %name_buf = load ptr, ptr %name_buf_ptr, align 8")
    irCall("val", "ptr", "getenv", "ptr %name_buf")
    irICmp("isnull", "eq", "ptr", "%val", "null")
    irBrCond("isnull", "nil", "ok")
    irLabel("nil")
    irCall("empty", "ptr", "ss_string_from_cstr", "ptr @.rt.str.empty")
    irRet("ptr", "%empty")
    irLabel("ok")
    irCall("result", "ptr", "ss_string_from_cstr", "ptr %val")
    irRet("ptr", "%result")
    emitIR("}")
    emitIR("")
}

// ── Math ──────────────────────────────────────────────────────

function emitRuntimeMath() {
    emitIR("define double @ss_sqrt(double %x) {")
    irCall("result", "double", "sqrt", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_abs(double %x) {")
    irCall("result", "double", "fabs", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_floor(double %x) {")
    irCall("result", "double", "floor", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_ceil(double %x) {")
    irCall("result", "double", "ceil", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_round(double %x) {")
    irCall("result", "double", "round", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_pow(double %base, double %exp) {")
    irCall("result", "double", "pow", "double %base, double %exp")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_log(double %x) {")
    irCall("result", "double", "log", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_sin(double %x) {")
    irCall("result", "double", "sin", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_cos(double %x) {")
    irCall("result", "double", "cos", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_tan(double %x) {")
    irCall("result", "double", "tan", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_asin(double %x) {")
    irCall("result", "double", "asin", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_acos(double %x) {")
    irCall("result", "double", "acos", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_atan(double %x) {")
    irCall("result", "double", "atan", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_atan2(double %y, double %x) {")
    irCall("result", "double", "atan2", "double %y, double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_exp(double %x) {")
    irCall("result", "double", "exp", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_log10(double %x) {")
    irCall("result", "double", "log10", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_log2(double %x) {")
    irCall("result", "double", "log2", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_trunc(double %x) {")
    irCall("result", "double", "trunc", "double %x")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_hypot(double %x, double %y) {")
    irCall("result", "double", "hypot", "double %x, double %y")
    irRet("double", "%result")
    emitIR("}")
    emitIR("define double @ss_fmod(double %x, double %y) {")
    irCall("result", "double", "fmod", "double %x, double %y")
    irRet("double", "%result")
    emitIR("}")
    emitIR("")
    // sign: returns -1.0, 0.0, or 1.0
    emitIR("define double @ss_sign(double %x) {")
    emitIR("  %is_pos = fcmp ogt double %x, 0.0")
    emitIR("  %is_neg = fcmp olt double %x, 0.0")
    emitIR("  %pos = select i1 %is_pos, double 1.0, double 0.0")
    emitIR("  %result = select i1 %is_neg, double -1.0, double %pos")
    irRet("double", "%result")
    emitIR("}")
    emitIR("")
    // cbrt: cube root
    emitIR("define double @ss_cbrt(double %x) {")
    emitIR("  %third = fdiv double 1.0, 3.0")
    irCall("result", "double", "pow", "double %x, double %third")
    irRet("double", "%result")
    emitIR("}")
    emitIR("")
    emitIR("define double @ss_min(double %a, double %b) {")
    emitIR("  %cmp = fcmp olt double %a, %b")
    emitIR("  %result = select i1 %cmp, double %a, double %b")
    irRet("double", "%result")
    emitIR("}")
    emitIR("")
    emitIR("define double @ss_max(double %a, double %b) {")
    emitIR("  %cmp = fcmp ogt double %a, %b")
    emitIR("  %result = select i1 %cmp, double %a, double %b")
    irRet("double", "%result")
    emitIR("}")
    emitIR("")
    emitIR("define double @ss_random() {")
    irCall("raw", "i32", "rand", "")
    emitIR("  %fp = sitofp i32 %raw to double")
    emitIR("  %result = fdiv double %fp, 2147483647.0")
    irRet("double", "%result")
    emitIR("}")
    emitIR("")
    emitIR("define i32 @ss_randomInt(i32 %max) {")
    emitIR("  %guard = icmp sle i32 %max, 0")
    emitIR("  br i1 %guard, label %bad, label %ok")
    emitIR("bad:")
    emitIR("  ret i32 0")
    emitIR("ok:")
    irCall("raw", "i32", "rand", "")
    emitIR("  %result = srem i32 %raw, %max")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")
}
