// gen_rt_map.ss — Runtime HashMap operations

// ── HashMap ───────────────────────────────────────────────────
// Layout: 64 bucket pointers (ptr) + size (i32) = 520 bytes
// MapEntry: key (ptr, offset 0), value (i64, offset 8), next (ptr, offset 16) = 24 bytes

function emitRuntimeMap() {
    // hash_str — djb2 hash mod 64
    emitIR("define internal i32 @hash_str(ptr %s) {")
    irLabel("entry")
    irAlloca("h", "i32", 4)
    irStore("i32", "5381", "%h")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irGEP("cp", "i8", "%s", "%ci")
    irLoad("ch", "i8", "%cp")
    irICmp("done", "eq", "i8", "%ch", "0")
    irBrCond("done", "ret", "body")
    irLabel("body")
    irLoad("hv", "i32", "%h")
    irMul("hv2", "i32", "%hv", "33")
    irZext("cv", "i8", "%ch", "i32")
    irAdd("hv3", "i32", "%hv2", "%cv")
    irStore("i32", "%hv3", "%h")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("ret")
    irLoad("rv", "i32", "%h")
    emitIR("  %rm = urem i32 %rv, 64")
    irRet("i32", "%rm")
    emitIR("}")
    emitIR("")

    // find_entry — internal helper. D168 §B.7: %key 是 SS String header,GEP buffer
    emitIR("define internal ptr @find_entry(ptr %map, ptr %key) {")
    irLabel("entry")
    emitIR("  %key_buf_ptr = getelementptr %String, ptr %key, i32 0, i32 2")
    emitIR("  %key_buf = load ptr, ptr %key_buf_ptr, align 8")
    irCall("idx", "i32", "hash_str", "ptr %key_buf")
    irSext("idx64", "i32", "%idx", "i64")
    irGEP("bp", "ptr", "%map", "%idx64")
    irLoad("e0", "ptr", "%bp")
    irAlloca("ea", "ptr", 8)
    irStore("ptr", "%e0", "%ea")
    irBr("loop")
    irLabel("loop")
    irLoad("e", "ptr", "%ea")
    irICmp("nil", "eq", "ptr", "%e", "null")
    irBrCond("nil", "notfound", "cmp")
    irLabel("cmp")
    irLoad("ek", "ptr", "%e")
    irCall("eq", "i32", "strcmp", "ptr %ek, ptr %key_buf")
    irICmp("match", "eq", "i32", "%eq", "0")
    irBrCond("match", "found", "next")
    irLabel("next")
    irGEP("np", "i8", "%e", "16")
    irLoad("nv", "ptr", "%np")
    irStore("ptr", "%nv", "%ea")
    irBr("loop")
    irLabel("found")
    irRet("ptr", "%e")
    irLabel("notfound")
    irRet("ptr", "null")
    emitIR("}")
    emitIR("")

    // ss_mapNew
    emitIR("define ptr @ss_mapNew() {")
    irCall("map", "ptr", "ss_rc_calloc", "i64 520, i32 2")
    irRet("ptr", "%map")
    emitIR("}")
    emitIR("")

    // ss_mapSet — on update: release old ptr value if val_type=1 (offset 516)
    emitIR("define void @ss_mapSet(ptr %map, ptr %key, i64 %val) {")
    irLabel("entry")
    irCall("e", "ptr", "find_entry", "ptr %map, ptr %key")
    irICmp("found", "ne", "ptr", "%e", "null")
    irBrCond("found", "update", "insert")
    irLabel("update")
    irGEP("vp", "i8", "%e", "8")
    emitIR("  ; Release old value if map has ptr values")
    irGEP("uvtpp", "i8", "%map", "516")
    irLoad("uvtp", "i32", "%uvtpp")
    irICmp("uisptr", "eq", "i32", "%uvtp", "1")
    irBrCond("uisptr", "rel.old", "do.store")
    irLabel("rel.old")
    irLoad("oldv", "i64", "%vp")
    irIntToPtr("oldp", "i64", "%oldv")
    // D168 §C.10-map: update 覆写旧值暂留 ss_rc_release(对 NEW value no-op = 泄漏)。
    // 真实释放(ss_release_any)依赖 §C.11 get 侧 retain —— map.get(string) 不 retain,
    // 旧值真释放会让 borrow-then-update 的借入引用悬空 UAF(实测全测 318/10)。
    irCallVoid("ss_rc_release", "ptr %oldp")
    irBr("do.store")
    irLabel("do.store")
    irStore("i64", "%val", "%vp")
    irRetVoid()
    irLabel("insert")
    irCall("ne", "ptr", "malloc", "i64 24")
    // D168 §B.7: ss_rc_strdup 接收 cstr;%key 是 SS String header,先 GEP buffer。
    // entry.key 内部存裸 cstr(byte ptr),与 strcmp / strlen 兼容。
    emitIR("  %ikey_buf_ptr = getelementptr %String, ptr %key, i32 0, i32 2")
    emitIR("  %ikey_buf = load ptr, ptr %ikey_buf_ptr, align 8")
    irCall("kd", "ptr", "ss_rc_strdup", "ptr %ikey_buf")
    irStore("ptr", "%kd", "%ne")
    irGEP("nvp", "i8", "%ne", "8")
    irStore("i64", "%val", "%nvp")
    irCall("idx", "i32", "hash_str", "ptr %ikey_buf")
    irSext("idx64", "i32", "%idx", "i64")
    irGEP("bp", "ptr", "%map", "%idx64")
    irLoad("old", "ptr", "%bp")
    irGEP("nnp", "i8", "%ne", "16")
    irStore("ptr", "%old", "%nnp")
    irStore("ptr", "%ne", "%bp")
    emitIR("  ; Increment size")
    irGEP("szp", "i8", "%map", "512")
    irLoad("sz", "i32", "%szp")
    irAdd("sz1", "i32", "%sz", "1")
    irStore("i32", "%sz1", "%szp")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_mapGet
    emitIR("define i64 @ss_mapGet(ptr %map, ptr %key) {")
    irLabel("entry")
    irCall("e", "ptr", "find_entry", "ptr %map, ptr %key")
    irICmp("nil", "eq", "ptr", "%e", "null")
    irBrCond("nil", "nf", "ok")
    irLabel("ok")
    irGEP("vp", "i8", "%e", "8")
    irLoad("v", "i64", "%vp")
    irRet("i64", "%v")
    irLabel("nf")
    irRet("i64", "0")
    emitIR("}")
    emitIR("")

    // ss_mapGetString
    emitIR("define ptr @ss_mapGetString(ptr %map, ptr %key) {")
    irLabel("entry")
    irCall("e", "ptr", "find_entry", "ptr %map, ptr %key")
    irICmp("nil", "eq", "ptr", "%e", "null")
    irBrCond("nil", "nf", "ok")
    irLabel("ok")
    irGEP("vp", "i8", "%e", "8")
    irLoad("v", "i64", "%vp")
    irIntToPtr("p", "i64", "%v")
    irRet("ptr", "%p")
    irLabel("nf")
    // D168 §B.7: not-found 也必须返 SS String header,包装 empty cstr
    irCall("nfstr", "ptr", "ss_string_from_cstr", "ptr @.rt.str.empty")
    irRet("ptr", "%nfstr")
    emitIR("}")
    emitIR("")

    // ss_mapHas
    emitIR("define i32 @ss_mapHas(ptr %map, ptr %key) {")
    irCall("e", "ptr", "find_entry", "ptr %map, ptr %key")
    irICmp("found", "ne", "ptr", "%e", "null")
    irZext("result", "i1", "%found", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_mapSize
    emitIR("define i32 @ss_mapSize(ptr %map) {")
    irGEP("szp", "i8", "%map", "512")
    irLoad("size", "i32", "%szp")
    irRet("i32", "%size")
    emitIR("}")
    emitIR("")

    // ss_mapDelete — D168 §B.7: %key 是 SS String header,GEP buffer
    emitIR("define void @ss_mapDelete(ptr %map, ptr %key) {")
    irLabel("entry")
    emitIR("  %key_buf_ptr = getelementptr %String, ptr %key, i32 0, i32 2")
    emitIR("  %key_buf = load ptr, ptr %key_buf_ptr, align 8")
    irCall("idx", "i32", "hash_str", "ptr %key_buf")
    irSext("idx64", "i32", "%idx", "i64")
    irGEP("bp", "ptr", "%map", "%idx64")
    irAlloca("prev", "ptr", 8)
    irStore("ptr", "null", "%prev")
    irAlloca("ea", "ptr", 8)
    irLoad("e0", "ptr", "%bp")
    irStore("ptr", "%e0", "%ea")
    irBr("loop")
    irLabel("loop")
    irLoad("e", "ptr", "%ea")
    irICmp("nil", "eq", "ptr", "%e", "null")
    irBrCond("nil", "done", "cmp")
    irLabel("cmp")
    irLoad("ek", "ptr", "%e")
    irCall("eq", "i32", "strcmp", "ptr %ek, ptr %key_buf")
    irICmp("match", "eq", "i32", "%eq", "0")
    irBrCond("match", "remove", "advance")
    irLabel("advance")
    irStore("ptr", "%e", "%prev")
    irGEP("nnp", "i8", "%e", "16")
    irLoad("nv", "ptr", "%nnp")
    irStore("ptr", "%nv", "%ea")
    irBr("loop")
    irLabel("remove")
    irGEP("enp", "i8", "%e", "16")
    irLoad("enxt", "ptr", "%enp")
    irLoad("pv", "ptr", "%prev")
    irICmp("has_prev", "ne", "ptr", "%pv", "null")
    irBrCond("has_prev", "unlink_mid", "unlink_head")
    irLabel("unlink_head")
    irStore("ptr", "%enxt", "%bp")
    irBr("dec")
    irLabel("unlink_mid")
    irGEP("pnp", "i8", "%pv", "16")
    irStore("ptr", "%enxt", "%pnp")
    irBr("dec")
    irLabel("dec")
    irGEP("szp", "i8", "%map", "512")
    irLoad("sz", "i32", "%szp")
    irSub("sz1", "i32", "%sz", "1")
    irStore("i32", "%sz1", "%szp")
    emitIR("  ; Release key (RC string) before freeing entry")
    irLoad("dk", "ptr", "%e")
    irCallVoid("ss_rc_release", "ptr %dk")
    emitIR("  ; Release value if map has ptr values")
    irGEP("dvtpp", "i8", "%map", "516")
    irLoad("dvtp", "i32", "%dvtpp")
    irICmp("disptr", "eq", "i32", "%dvtp", "1")
    irBrCond("disptr", "del.relval", "del.free")
    irLabel("del.relval")
    irGEP("dvp", "i8", "%e", "8")
    irLoad("dvi", "i64", "%dvp")
    irIntToPtr("dvptr", "i64", "%dvi")
    // D168 §C.10-map: delete value 释放暂留 ss_rc_release(同 ss_mapSet update —
    // 真实释放依赖 §C.11 get 侧 retain,否则 borrow-then-delete UAF)。
    irCallVoid("ss_rc_release", "ptr %dvptr")
    irBr("del.free")
    irLabel("del.free")
    irCallVoid("free", "ptr %e")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_mapKeys — returns newline-separated string (dynamic buffer)
    emitIR("define ptr @ss_mapKeys(ptr %map) {")
    irLabel("entry")
    irAlloca("bufp", "ptr", 8)
    irAlloca("cap", "i64", 8)
    irCall("r0", "ptr", "ss_rc_alloc", "i64 4096, i32 0")
    irStore("ptr", "%r0", "%bufp")
    irStore("i64", "4096", "%cap")
    irAlloca("pos", "i64", 8)
    irStore("i64", "0", "%pos")
    irAlloca("bi", "i64", 8)
    irStore("i64", "0", "%bi")
    irBr("bloop")
    irLabel("bloop")
    irLoad("cbi", "i64", "%bi")
    irICmp("bcond", "slt", "i64", "%cbi", "64")
    irBrCond("bcond", "bbody", "done")
    irLabel("bbody")
    irGEP("bp", "ptr", "%map", "%cbi")
    irLoad("e0", "ptr", "%bp")
    irAlloca("ea", "ptr", 8)
    irStore("ptr", "%e0", "%ea")
    irBr("eloop")
    irLabel("eloop")
    irLoad("e", "ptr", "%ea")
    irICmp("enil", "eq", "ptr", "%e", "null")
    irBrCond("enil", "bnext", "ecopy")
    irLabel("ecopy")
    irLoad("ek", "ptr", "%e")
    irCall("klen", "i64", "strlen", "ptr %ek")
    irLoad("cpos", "i64", "%pos")
    // ensure capacity for key + newline + null
    irAdd("need", "i64", "%cpos", "%klen")
    irAdd("need2", "i64", "%need", "2")
    irCall("cbuf", "ptr", "ss_rt_ensure_cap", "ptr %bufp, ptr %cap, i64 %need2")
    irGEP("dst", "i8", "%cbuf", "%cpos")
    irCall("_1", "ptr", "memcpy", "ptr %dst, ptr %ek, i64 %klen")
    irAdd("np1", "i64", "%cpos", "%klen")
    irGEP("nlp", "i8", "%cbuf", "%np1")
    irStore("i8", "10", "%nlp")
    irAdd("np2", "i64", "%np1", "1")
    irStore("i64", "%np2", "%pos")
    irGEP("enp", "i8", "%e", "16")
    irLoad("nxt", "ptr", "%enp")
    irStore("ptr", "%nxt", "%ea")
    irBr("eloop")
    irLabel("bnext")
    irAdd("nbi", "i64", "%cbi", "1")
    irStore("i64", "%nbi", "%bi")
    irBr("bloop")
    irLabel("done")
    irLoad("fpos", "i64", "%pos")
    irLoad("fbuf", "ptr", "%bufp")
    irGEP("fterm", "i8", "%fbuf", "%fpos")
    irStore("i8", "0", "%fterm")
    // D168 §B.7: 包装 byte buf → SS String header,释放原 byte buf
    irCall("retstr", "ptr", "ss_string_from_cstr", "ptr %fbuf")
    irCallVoid("ss_rc_release", "ptr %fbuf")
    irRet("ptr", "%retstr")
    emitIR("}")
    emitIR("")

    // ss_mapKeysArray — returns Array<string> of all keys
    emitIR("define ptr @ss_mapKeysArray(ptr %map) {")
    irLabel("entry")
    // Read map size
    irGEP("szp", "i8", "%map", "512")
    irLoad("sz", "i32", "%szp")
    // Allocate ptr array (tag=5 for string elements)
    irCall("arr", "ptr", "ss_newArrayPtr", "i32 %sz")
    // Index into array for next insert
    irAlloca("ai", "i64", 8)
    irStore("i64", "0", "%ai")
    // Iterate 64 buckets
    irAlloca("bi", "i64", 8)
    irStore("i64", "0", "%bi")
    irBr("bloop")
    irLabel("bloop")
    irLoad("cbi", "i64", "%bi")
    irICmp("bcond", "slt", "i64", "%cbi", "64")
    irBrCond("bcond", "bbody", "done")
    irLabel("bbody")
    irGEP("bp", "ptr", "%map", "%cbi")
    irLoad("e0", "ptr", "%bp")
    irAlloca("ea", "ptr", 8)
    irStore("ptr", "%e0", "%ea")
    irBr("eloop")
    irLabel("eloop")
    irLoad("e", "ptr", "%ea")
    irICmp("enil", "eq", "ptr", "%e", "null")
    irBrCond("enil", "bnext", "ecopy")
    irLabel("ecopy")
    // D168 §B.7: entry.key 内部存裸 cstr,包装成 String header 给 Array<string>
    irLoad("ek", "ptr", "%e")
    irCall("kdup", "ptr", "ss_string_from_cstr", "ptr %ek")
    // Store into array via ss_arraySet API
    irLoad("ci", "i64", "%ai")
    irTrunc("ci32", "i64", "%ci", "i32")
    irPtrToInt("kv", "%kdup", "i64")
    irCallVoid("ss_arraySet", "ptr %arr, i32 %ci32, i64 %kv")
    // Advance array index
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%ai")
    // Next entry in bucket chain
    irGEP("enp", "i8", "%e", "16")
    irLoad("nxt", "ptr", "%enp")
    irStore("ptr", "%nxt", "%ea")
    irBr("eloop")
    irLabel("bnext")
    irAdd("nbi", "i64", "%cbi", "1")
    irStore("i64", "%nbi", "%bi")
    irBr("bloop")
    irLabel("done")
    irRet("ptr", "%arr")
    emitIR("}")
    emitIR("")
}
