// gen_rt_array.ss — Runtime array/list operations
// Layout: header [len(i64), cap(i64), data(ptr as i64)] + separate data buffer

// ── Array operations ──────────────────────────────────────────

function emitNewArrayFn(name: string, tag: string) {
    emitIR(`define ptr @${name}(i32 %size) {`)
    irLabel("entry")
    irSext("size64", "i32", "%size", "i64")
    irCall("hdr", "ptr", "ss_rc_calloc", `i64 24, i32 ${tag}`)
    irStore("i64", "%size64", "%hdr")
    irGEP("capp", "i64", "%hdr", "1")
    irStore("i64", "%size64", "%capp")
    irICmp("need_data", "sgt", "i32", "%size", "0")
    irBrCond("need_data", "alloc_data", "done")
    irLabel("alloc_data")
    irMul("dbytes", "i64", "%size64", "8")
    irCall("data", "ptr", "calloc", "i64 %dbytes, i64 1")
    irPtrToInt("data_i", "%data", "i64")
    irGEP("datap", "i64", "%hdr", "2")
    irStore("i64", "%data_i", "%datap")
    irBr("done")
    irLabel("done")
    irRet("ptr", "%hdr")
    emitIR("}")
    emitIR("")
}

function emitRuntimeArrayOps() {
    // Header layout:
    //   slot 0 (GEP i64, arr, 0): len  — current element count
    //   slot 1 (GEP i64, arr, 1): cap  — allocated capacity
    //   slot 2 (GEP i64, arr, 2): data — ptrtoint of data buffer pointer
    // Data buffer: plain calloc/realloc, elements stored as i64

    emitNewArrayFn("ss_newArray", "1")
    emitNewArrayFn("ss_newArrayPtr", "5")

    // ss_arrayLen
    emitIR("define i32 @ss_arrayLen(ptr %arr) {")
    irLoad("len", "i64", "%arr")
    irTrunc("result", "i64", "%len", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_arrayGet
    emitIR("define i64 @ss_arrayGet(ptr %arr, i32 %idx) {")
    irSext("idx64", "i32", "%idx", "i64")
    irLoadArrayData("data", "%arr")
    irGEP("elemp", "i64", "%data", "%idx64")
    irLoad("val", "i64", "%elemp")
    irRet("i64", "%val")
    emitIR("}")
    emitIR("")

    // ss_arraySet
    emitIR("define void @ss_arraySet(ptr %arr, i32 %idx, i64 %val) {")
    irSext("idx64", "i32", "%idx", "i64")
    irLoadArrayData("data", "%arr")
    irGEP("elemp", "i64", "%data", "%idx64")
    irStore("i64", "%val", "%elemp")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_arrayPush — grow data if needed, returns SAME header ptr
    emitIR("define ptr @ss_arrayPush(ptr %arr, i64 %val) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irGEP("capp", "i64", "%arr", "1")
    irLoad("cap", "i64", "%capp")
    irICmp("full", "eq", "i64", "%len", "%cap")
    irBrCond("full", "grow", "store")
    irLabel("grow")
    irICmp("is_zero", "eq", "i64", "%cap", "0")
    irBrCond("is_zero", "set_cap", "double_cap")
    irLabel("double_cap")
    irMul("doubled", "i64", "%cap", "2")
    irBr("do_realloc")
    irLabel("set_cap")
    irBr("do_realloc")
    irLabel("do_realloc")
    emitIR("  %newcap = phi i64 [ 4, %set_cap ], [ %doubled, %double_cap ]")
    irMul("nbytes", "i64", "%newcap", "8")
    irLoadArrayData("old", "%arr")
    irCall("newbuf", "ptr", "realloc", "ptr %old, i64 %nbytes")
    irPtrToInt("new_i", "%newbuf", "i64")
    irGEP("datap_g", "i64", "%arr", "2")
    irStore("i64", "%new_i", "%datap_g")
    irStore("i64", "%newcap", "%capp")
    irBr("store")
    irLabel("store")
    irLoadArrayData("data_s", "%arr")
    irGEP("dst", "i64", "%data_s", "%len")
    irStore("i64", "%val", "%dst")
    irAdd("newlen", "i64", "%len", "1")
    irStore("i64", "%newlen", "%arr")
    irRet("ptr", "%arr")
    emitIR("}")
    emitIR("")

    // ss_arraySort (qsort on data buffer)
    emitIR("define internal i32 @ss_cmp_asc(ptr %a, ptr %b) {")
    irLoad("va", "i64", "%a")
    irLoad("vb", "i64", "%b")
    irICmp("gt", "sgt", "i64", "%va", "%vb")
    irICmp("lt", "slt", "i64", "%va", "%vb")
    irZext("gti", "i1", "%gt", "i32")
    irZext("lti", "i1", "%lt", "i32")
    irSub("result", "i32", "%gti", "%lti")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")
    emitIR("define void @ss_arraySort(ptr %arr) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irICmp("need_sort", "sgt", "i64", "%len", "1")
    irBrCond("need_sort", "sort", "done")
    irLabel("sort")
    irLoadArrayData("data", "%arr")
    irCallVoid("qsort", "ptr %data, i64 %len, i64 8, ptr @ss_cmp_asc")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_arrayReverse
    emitIR("define void @ss_arrayReverse(ptr %arr) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irSDiv("half", "i64", "%len", "2")
    irLoadArrayData("data", "%arr")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%half")
    irBrCond("cond", "body", "done")
    irLabel("body")
    irSub("ri", "i64", "%len", "%ci")
    irSub("ri1", "i64", "%ri", "1")
    irGEP("lp", "i64", "%data", "%ci")
    irGEP("rp", "i64", "%data", "%ri1")
    irLoad("lv", "i64", "%lp")
    irLoad("rv", "i64", "%rp")
    irStore("i64", "%rv", "%lp")
    irStore("i64", "%lv", "%rp")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_arrayFirst
    emitIR("define i64 @ss_arrayFirst(ptr %arr) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irICmp("has", "sgt", "i64", "%len", "0")
    irBrCond("has", "has_elem", "empty")
    irLabel("has_elem")
    irLoadArrayData("data", "%arr")
    irLoad("val", "i64", "%data")
    irRet("i64", "%val")
    irLabel("empty")
    irRet("i64", "0")
    emitIR("}")
    emitIR("")

    // ss_arrayLast
    emitIR("define i64 @ss_arrayLast(ptr %arr) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irICmp("has", "sgt", "i64", "%len", "0")
    irBrCond("has", "has_elem", "empty")
    irLabel("has_elem")
    irSub("last", "i64", "%len", "1")
    irLoadArrayData("data", "%arr")
    irGEP("ptr", "i64", "%data", "%last")
    irLoad("val", "i64", "%ptr")
    irRet("i64", "%val")
    irLabel("empty")
    irRet("i64", "0")
    emitIR("}")
    emitIR("")

    // ss_arrayIndexOf
    emitIR("define i32 @ss_arrayIndexOf(ptr %arr, i64 %needle) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irLoadArrayData("data", "%arr")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%len")
    irBrCond("cond", "body", "notfound")
    irLabel("body")
    irGEP("ep", "i64", "%data", "%ci")
    irLoad("ev", "i64", "%ep")
    irICmp("eq", "eq", "i64", "%ev", "%needle")
    irBrCond("eq", "found", "inc")
    irLabel("inc")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("found")
    irTrunc("ri", "i64", "%ci", "i32")
    irRet("i32", "%ri")
    irLabel("notfound")
    irRet("i32", "-1")
    emitIR("}")
    emitIR("")

    // ss_arrayIndexOfStr — linear scan with strcmp, for Array<string>.indexOf
    // Elements are stored as i64 (ptrtoint of string ptr); cast back and strcmp against needle.
    emitIR("define i32 @ss_arrayIndexOfStr(ptr %arr, ptr %needle) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irLoadArrayData("data", "%arr")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%len")
    irBrCond("cond", "body", "notfound")
    irLabel("body")
    irGEP("ep", "i64", "%data", "%ci")
    irLoad("ev", "i64", "%ep")
    emitIR("  %ep_ptr = inttoptr i64 %ev to ptr")
    irCall("cmp", "i32", "strcmp", "ptr %ep_ptr, ptr %needle")
    irICmp("eq", "eq", "i32", "%cmp", "0")
    irBrCond("eq", "found", "inc")
    irLabel("inc")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("found")
    irTrunc("ri", "i64", "%ci", "i32")
    irRet("i32", "%ri")
    irLabel("notfound")
    irRet("i32", "-1")
    emitIR("}")
    emitIR("")

    // ss_arraySlice — create new header+data, copy from source
    emitIR("define ptr @ss_arraySlice(ptr %arr, i32 %start, i32 %end_idx) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irSext("s", "i32", "%start", "i64")
    irSext("e", "i32", "%end_idx", "i64")
    irICmp("e2", "sgt", "i64", "%e", "%len")
    irSelect("end", "e2", "i64", "%len", "%e")
    irSub("nlen", "i64", "%end", "%s")
    irICmp("nlen2", "slt", "i64", "%nlen", "0")
    irSelect("nlen3", "nlen2", "i64", "0", "%nlen")
    // Inherit tag from source
    irGEP("src_tagp", "i8", "%arr", "-8")
    irLoad("src_tag", "i32", "%src_tagp")
    irCall("hdr", "ptr", "ss_rc_calloc", "i64 24, i32 %src_tag")
    irStore("i64", "%nlen3", "%hdr")
    irGEP("capp", "i64", "%hdr", "1")
    irStore("i64", "%nlen3", "%capp")
    irICmp("has_elems", "sgt", "i64", "%nlen3", "0")
    irBrCond("has_elems", "copy", "done")
    irLabel("copy")
    irMul("dbytes", "i64", "%nlen3", "8")
    irCall("newdata", "ptr", "calloc", "i64 %dbytes, i64 1")
    irPtrToInt("nd_i", "%newdata", "i64")
    irGEP("hdatap", "i64", "%hdr", "2")
    irStore("i64", "%nd_i", "%hdatap")
    irLoadArrayData("src_data", "%arr")
    irGEP("srcp", "i64", "%src_data", "%s")
    irCall("_1", "ptr", "memcpy", "ptr %newdata, ptr %srcp, i64 %dbytes")
    // If ptr array (tag=5), retain all copied elements
    irICmp("is_ptr", "eq", "i32", "%src_tag", "5")
    irBrCond("is_ptr", "retain.init", "done")
    irLabel("retain.init")
    irAlloca("ria", "i64", 8)
    irStore("i64", "0", "%ria")
    irBr("retain.loop")
    irLabel("retain.loop")
    irLoad("ri", "i64", "%ria")
    irICmp("rdone", "eq", "i64", "%ri", "%nlen3")
    irBrCond("rdone", "done", "retain.body")
    irLabel("retain.body")
    irGEP("rep", "i64", "%newdata", "%ri")
    irLoad("rev", "i64", "%rep")
    irIntToPtr("rptr", "i64", "%rev")
    irCallVoid("ss_rc_retain", "ptr %rptr")
    irAdd("rni", "i64", "%ri", "1")
    irStore("i64", "%rni", "%ria")
    irBr("retain.loop")
    irLabel("done")
    irRet("ptr", "%hdr")
    emitIR("}")
    emitIR("")

    // ss_arrayConcat — create new header+data from two arrays
    emitIR("define ptr @ss_arrayConcat(ptr %a, ptr %b) {")
    irLabel("entry")
    irLoad("alen", "i64", "%a")
    irLoad("blen", "i64", "%b")
    irAdd("total", "i64", "%alen", "%blen")
    irGEP("src_tagp", "i8", "%a", "-8")
    irLoad("src_tag", "i32", "%src_tagp")
    irCall("hdr", "ptr", "ss_rc_calloc", "i64 24, i32 %src_tag")
    irStore("i64", "%total", "%hdr")
    irGEP("capp", "i64", "%hdr", "1")
    irStore("i64", "%total", "%capp")
    irICmp("has_elems", "sgt", "i64", "%total", "0")
    irBrCond("has_elems", "alloc_data", "done")
    irLabel("alloc_data")
    irMul("dbytes", "i64", "%total", "8")
    irCall("newdata", "ptr", "calloc", "i64 %dbytes, i64 1")
    irPtrToInt("nd_i", "%newdata", "i64")
    irGEP("hdatap", "i64", "%hdr", "2")
    irStore("i64", "%nd_i", "%hdatap")
    irLoadArrayData("a_data", "%a")
    irMul("abytes", "i64", "%alen", "8")
    irCall("_1", "ptr", "memcpy", "ptr %newdata, ptr %a_data, i64 %abytes")
    irLoadArrayData("b_data", "%b")
    irGEP("dst2", "i64", "%newdata", "%alen")
    irMul("bbytes", "i64", "%blen", "8")
    irCall("_2", "ptr", "memcpy", "ptr %dst2, ptr %b_data, i64 %bbytes")
    // If ptr array (tag=5), retain all elements
    irICmp("is_ptr", "eq", "i32", "%src_tag", "5")
    irBrCond("is_ptr", "retain.init", "done")
    irLabel("retain.init")
    irAlloca("ria", "i64", 8)
    irStore("i64", "0", "%ria")
    irBr("retain.loop")
    irLabel("retain.loop")
    irLoad("ri", "i64", "%ria")
    irICmp("rdone", "eq", "i64", "%ri", "%total")
    irBrCond("rdone", "done", "retain.body")
    irLabel("retain.body")
    irGEP("rep", "i64", "%newdata", "%ri")
    irLoad("rev", "i64", "%rep")
    irIntToPtr("rptr", "i64", "%rev")
    irCallVoid("ss_rc_retain", "ptr %rptr")
    irAdd("rni", "i64", "%ri", "1")
    irStore("i64", "%rni", "%ria")
    irBr("retain.loop")
    irLabel("done")
    irRet("ptr", "%hdr")
    emitIR("}")
    emitIR("")

    // ss_arrayToString — "[1, 2, 3]" style output (dynamic buffer)
    emitIR("define ptr @ss_arrayToString(ptr %arr) {")
    irLabel("entry")
    irLoad("len", "i64", "%arr")
    irLoadArrayData("data", "%arr")
    irAlloca("bufp", "ptr", 8)
    irAlloca("cap", "i64", 8)
    irCall("r0", "ptr", "ss_rc_alloc", "i64 256, i32 0")
    irStore("ptr", "%r0", "%bufp")
    irStore("i64", "256", "%cap")
    irStore("i8", "91", "%r0")
    irAlloca("pos", "i64", 8)
    irStore("i64", "1", "%pos")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%len")
    irBrCond("cond", "body", "end")
    irLabel("body")
    irLoad("bpos", "i64", "%pos")
    irAdd("bneed", "i64", "%bpos", "260")
    irCall("bbuf", "ptr", "ss_rt_ensure_cap", "ptr %bufp, ptr %cap, i64 %bneed")
    irICmp("ci0", "sgt", "i64", "%ci", "0")
    irBrCond("ci0", "comma", "val")
    irLabel("comma")
    irLoad("cp2", "i64", "%pos")
    irGEP("dp", "i8", "%bbuf", "%cp2")
    irStore("i8", "44", "%dp")
    irAdd("cp3", "i64", "%cp2", "1")
    irGEP("dp2", "i8", "%bbuf", "%cp3")
    irStore("i8", "32", "%dp2")
    irAdd("cp4", "i64", "%cp3", "1")
    irStore("i64", "%cp4", "%pos")
    irBr("val")
    irLabel("val")
    irGEP("ep", "i64", "%data", "%ci")
    irLoad("ev", "i64", "%ep")
    irLoad("vp", "i64", "%pos")
    irGEP("dest", "i8", "%bbuf", "%vp")
    irCall("written", "i32 (ptr, i64, ptr, ...)", "snprintf", "ptr %dest, i64 256, ptr @.rt.fmt.lld, i64 %ev")
    irSext("w64", "i32", "%written", "i64")
    irAdd("np", "i64", "%vp", "%w64")
    irStore("i64", "%np", "%pos")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("end")
    irLoad("fp", "i64", "%pos")
    irAdd("fn", "i64", "%fp", "2")
    irCall("fbuf", "ptr", "ss_rt_ensure_cap", "ptr %bufp, ptr %cap, i64 %fn")
    irGEP("ep2", "i8", "%fbuf", "%fp")
    irStore("i8", "93", "%ep2")
    irAdd("fp2", "i64", "%fp", "1")
    irGEP("ep3", "i8", "%fbuf", "%fp2")
    irStore("i8", "0", "%ep3")
    irRet("ptr", "%fbuf")
    emitIR("}")
    emitIR("")
}
