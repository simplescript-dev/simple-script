// gen_rt_array.ss — Runtime array/list operations
// D168 §C: layout {i64 rc, ptr TypeInfo, ptr buffer, i64 len, i64 cap} 40B 间接 buffer
//   (rc@0 + TypeInfo@1 + buffer@2 + len@3 + cap@4)。P2.2 切轨完成 scalar Array,
//   ref Array 字面量元素 retain / push/pop dispatch 留 P2.3。

// ── Array operations ──────────────────────────────────────────

function emitNewArrayFn(name: string, tiName: string) {
    emitIR(`define ptr @${name}(i32 %size) {`)
    irLabel("entry")
    irSext("size64", "i32", "%size", "i64")
    // D168 §C.4: ss_alloc_array(elem_size=8, cap=size, type_info)
    // 内部 mi_calloc 40B header + buffer + 设 rc=1 / TypeInfo / buffer / cap
    irCall("hdr", "ptr", "ss_alloc_array", `i64 8, i64 %size64, ptr ${tiName}`)
    // 设 len = size(ss_alloc_array 默认 len=0)
    emitIR("  %lenp = getelementptr %Array, ptr %hdr, i32 0, i32 3")
    irStore("i64", "%size64", "%lenp")
    irRet("ptr", "%hdr")
    emitIR("}")
    emitIR("")
}

function emitRuntimeArrayOps() {
    // D168 §C.6 header layout(切轨后): {i64 rc, ptr TypeInfo, ptr buffer, i64 len, i64 cap}
    //   GEP 0 rc / GEP 1 TypeInfo / GEP 2 buffer / GEP 3 len / GEP 4 cap
    //   buffer 直接 ptr load(旧 i64 inttoptr 已删除,见 irLoadArrayData);
    //   ss_alloc_array helper 已在 emitArrayTypeInfo() 内 emit(gen_runtime.ss:898)。
    // Data buffer: 元素 i64 槽,scalar 直接放,ref 通过 ptrtoint 装入。

    emitNewArrayFn("ss_newArray", "@Array_scalar_type_info")
    emitNewArrayFn("ss_newArrayPtr", "@Array_ref_type_info")

    // ss_arrayLen — D168 §C.6: len 在 GEP 3
    emitIR("define i32 @ss_arrayLen(ptr %arr) {")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irTrunc("result", "i64", "%len", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_arrayGet
    emitIR("define i64 @ss_arrayGet(ptr %arr, i32 %idx) {")
    irSext("idx64", "i32", "%idx", "i64")
    irLoadArrayData("data", "%arr")
    irGEP("elemp", "i64", "%data", "%idx64")
    irLoad("val", "i64", "%elemp")
    irRet("i64", "%val")
    emitIR("}")
    emitIR("")

    // ss_arraySet
    emitIR("define void @ss_arraySet(ptr %arr, i32 %idx, i64 %val) {")
    irSext("idx64", "i32", "%idx", "i64")
    irLoadArrayData("data", "%arr")
    irGEP("elemp", "i64", "%data", "%idx64")
    irStore("i64", "%val", "%elemp")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_arrayPush — D168 §C.6: len@3 / cap@4 / buffer@2(ptr 直接);realloc 后写 buffer 字段
    // header ptr 不变(Perceus owned/borrow 引用稳定);仅 buffer slot + len + cap 字段更新
    emitIR("define ptr @ss_arrayPush(ptr %arr, i64 %val) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    emitIR("  %capp = getelementptr %Array, ptr %arr, i32 0, i32 4")
    irLoad("cap", "i64", "%capp")
    irICmp("full", "eq", "i64", "%len", "%cap")
    irBrCond("full", "grow", "store")
    irLabel("grow")
    irICmp("is_zero", "eq", "i64", "%cap", "0")
    irBrCond("is_zero", "set_cap", "double_cap")
    irLabel("double_cap")
    irMul("doubled", "i64", "%cap", "2")
    irBr("do_realloc")
    irLabel("set_cap")
    irBr("do_realloc")
    irLabel("do_realloc")
    emitIR("  %newcap = phi i64 [ 4, %set_cap ], [ %doubled, %double_cap ]")
    irMul("nbytes", "i64", "%newcap", "8")
    irLoadArrayData("old", "%arr")
    // D168 §C.4: buffer 由 mi_calloc 分配,扩容必须用 mi_realloc(libc realloc 与 mimalloc 不兼容)
    irCall("newbuf", "ptr", "mi_realloc", "ptr %old, i64 %nbytes")
    emitIR("  %datap_g = getelementptr %Array, ptr %arr, i32 0, i32 2")
    emitIR("  store ptr %newbuf, ptr %datap_g, align 8")
    irStore("i64", "%newcap", "%capp")
    irBr("store")
    irLabel("store")
    irLoadArrayData("data_s", "%arr")
    irGEP("dst", "i64", "%data_s", "%len")
    irStore("i64", "%val", "%dst")
    irAdd("newlen", "i64", "%len", "1")
    irStore("i64", "%newlen", "%lenp")
    irRet("ptr", "%arr")
    emitIR("}")
    emitIR("")

    // ss_arraySort (qsort on data buffer)
    emitIR("define internal i32 @ss_cmp_asc(ptr %a, ptr %b) {")
    irLoad("va", "i64", "%a")
    irLoad("vb", "i64", "%b")
    irICmp("gt", "sgt", "i64", "%va", "%vb")
    irICmp("lt", "slt", "i64", "%va", "%vb")
    irZext("gti", "i1", "%gt", "i32")
    irZext("lti", "i1", "%lt", "i32")
    irSub("result", "i32", "%gti", "%lti")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")
    emitIR("define void @ss_arraySort(ptr %arr) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irICmp("need_sort", "sgt", "i64", "%len", "1")
    irBrCond("need_sort", "sort", "done")
    irLabel("sort")
    irLoadArrayData("data", "%arr")
    irCallVoid("qsort", "ptr %data, i64 %len, i64 8, ptr @ss_cmp_asc")
    irBr("done")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_arrayReverse — D168 §C.6: len@3
    emitIR("define void @ss_arrayReverse(ptr %arr) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irSDiv("half", "i64", "%len", "2")
    irLoadArrayData("data", "%arr")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%half")
    irBrCond("cond", "body", "done")
    irLabel("body")
    irSub("ri", "i64", "%len", "%ci")
    irSub("ri1", "i64", "%ri", "1")
    irGEP("lp", "i64", "%data", "%ci")
    irGEP("rp", "i64", "%data", "%ri1")
    irLoad("lv", "i64", "%lp")
    irLoad("rv", "i64", "%rp")
    irStore("i64", "%rv", "%lp")
    irStore("i64", "%lv", "%rp")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("done")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // ss_arrayFirst — D168 §C.6: len@3
    emitIR("define i64 @ss_arrayFirst(ptr %arr) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irICmp("has", "sgt", "i64", "%len", "0")
    irBrCond("has", "has_elem", "empty")
    irLabel("has_elem")
    irLoadArrayData("data", "%arr")
    irLoad("val", "i64", "%data")
    irRet("i64", "%val")
    irLabel("empty")
    irRet("i64", "0")
    emitIR("}")
    emitIR("")

    // ss_arrayLast — D168 §C.6: len@3
    emitIR("define i64 @ss_arrayLast(ptr %arr) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irICmp("has", "sgt", "i64", "%len", "0")
    irBrCond("has", "has_elem", "empty")
    irLabel("has_elem")
    irSub("last", "i64", "%len", "1")
    irLoadArrayData("data", "%arr")
    irGEP("ptr", "i64", "%data", "%last")
    irLoad("val", "i64", "%ptr")
    irRet("i64", "%val")
    irLabel("empty")
    irRet("i64", "0")
    emitIR("}")
    emitIR("")

    // ss_arrayIndexOf — D168 §C.6: len@3
    emitIR("define i32 @ss_arrayIndexOf(ptr %arr, i64 %needle) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irLoadArrayData("data", "%arr")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%len")
    irBrCond("cond", "body", "notfound")
    irLabel("body")
    irGEP("ep", "i64", "%data", "%ci")
    irLoad("ev", "i64", "%ep")
    irICmp("eq", "eq", "i64", "%ev", "%needle")
    irBrCond("eq", "found", "inc")
    irLabel("inc")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("found")
    irTrunc("ri", "i64", "%ci", "i32")
    irRet("i32", "%ri")
    irLabel("notfound")
    irRet("i32", "-1")
    emitIR("}")
    emitIR("")

    // ss_arrayIndexOfStr — linear scan with ss_string_eq, for Array<string>.indexOf
    // D168 §C.6: len@3;元素和 needle 都是 SS String header,走 ss_string_eq(D168 §B.7)
    emitIR("define i32 @ss_arrayIndexOfStr(ptr %arr, ptr %needle) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irLoadArrayData("data", "%arr")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%len")
    irBrCond("cond", "body", "notfound")
    irLabel("body")
    irGEP("ep", "i64", "%data", "%ci")
    irLoad("ev", "i64", "%ep")
    emitIR("  %ep_ptr = inttoptr i64 %ev to ptr")
    // D168 §B.7: 数组元素和 needle 都是 SS String header,用 ss_string_eq(已 GEP 内置)
    irCall("eq_r", "i32", "ss_string_eq", "ptr %ep_ptr, ptr %needle")
    irICmp("eq", "eq", "i32", "%eq_r", "1")
    irBrCond("eq", "found", "inc")
    irLabel("inc")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("found")
    irTrunc("ri", "i64", "%ci", "i32")
    irRet("i32", "%ri")
    irLabel("notfound")
    irRet("i32", "-1")
    emitIR("}")
    emitIR("")

    // ss_arraySlice — D168 §C.6: TypeInfo 继承 (GEP 1) + ss_alloc_array + len@3
    // 旧 tag (GEP -8) 已废,改读源 TypeInfo;ref 元素 retain 改走元素 ObjHeader vtable (ss_retain)
    emitIR("define ptr @ss_arraySlice(ptr %arr, i32 %start, i32 %end_idx) {")
    irLabel("entry")
    emitIR("  %src_lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%src_lenp")
    irSext("s", "i32", "%start", "i64")
    irSext("e", "i32", "%end_idx", "i64")
    // finding B (D171 §收口验收): 负 start/end 归一 (neg → len+neg) + clamp,runtime 边界单一真相源,
    // 对齐 comptime ctArrayMethod slice (exprs_ct_builtin.ss:156-159) + JS slice 语义。
    // 负 start → len+s 再 clamp 下界 0 (防 GEP srcp 越界);负 end → len+e;end 上界 clamp 到 len。
    irICmp("s_neg", "slt", "i64", "%s", "0")
    irAdd("s_add", "i64", "%len", "%s")
    irSelect("s_norm", "s_neg", "i64", "%s_add", "%s")
    irICmp("s_lo", "slt", "i64", "%s_norm", "0")
    irSelect("s_c", "s_lo", "i64", "0", "%s_norm")
    irICmp("e_neg", "slt", "i64", "%e", "0")
    irAdd("e_add", "i64", "%len", "%e")
    irSelect("e_norm", "e_neg", "i64", "%e_add", "%e")
    irICmp("e2", "sgt", "i64", "%e_norm", "%len")
    irSelect("end", "e2", "i64", "%len", "%e_norm")
    irSub("nlen", "i64", "%end", "%s_c")
    irICmp("nlen2", "slt", "i64", "%nlen", "0")
    irSelect("nlen3", "nlen2", "i64", "0", "%nlen")
    // 继承源 TypeInfo (GEP 1)
    emitIR("  %src_tip = getelementptr %Array, ptr %arr, i32 0, i32 1")
    emitIR("  %src_ti = load ptr, ptr %src_tip, align 8")
    // ss_alloc_array 一次性 alloc header + buffer + 设 rc=1/TypeInfo/buffer/cap
    irCall("hdr", "ptr", "ss_alloc_array", "i64 8, i64 %nlen3, ptr %src_ti")
    // Set len = nlen3 (ss_alloc_array 默认 len=0)
    emitIR("  %hdr_lenp = getelementptr %Array, ptr %hdr, i32 0, i32 3")
    irStore("i64", "%nlen3", "%hdr_lenp")
    irICmp("has_elems", "sgt", "i64", "%nlen3", "0")
    irBrCond("has_elems", "copy", "done")
    irLabel("copy")
    irMul("dbytes", "i64", "%nlen3", "8")
    irLoadArrayData("newdata", "%hdr")
    irLoadArrayData("src_data", "%arr")
    irGEP("srcp", "i64", "%src_data", "%s_c")
    irCall("_1", "ptr", "memcpy", "ptr %newdata, ptr %srcp, i64 %dbytes")
    // 若 ref array (TypeInfo == @Array_ref_type_info),元素 retain 走元素 vtable
    emitIR("  %is_ref = icmp eq ptr %src_ti, @Array_ref_type_info")
    irBrCond("is_ref", "retain.init", "done")
    irLabel("retain.init")
    irAlloca("ria", "i64", 8)
    irStore("i64", "0", "%ria")
    irBr("retain.loop")
    irLabel("retain.loop")
    irLoad("ri", "i64", "%ria")
    irICmp("rdone", "eq", "i64", "%ri", "%nlen3")
    irBrCond("rdone", "done", "retain.body")
    irLabel("retain.body")
    irGEP("rep", "i64", "%newdata", "%ri")
    irLoad("rev", "i64", "%rep")
    irIntToPtr("rptr", "i64", "%rev")
    irCallVoid("ss_retain", "ptr %rptr")
    irAdd("rni", "i64", "%ri", "1")
    irStore("i64", "%rni", "%ria")
    irBr("retain.loop")
    irLabel("done")
    irRet("ptr", "%hdr")
    emitIR("}")
    emitIR("")

    // ss_arrayConcat — D168 §C.6: TypeInfo 继承 (GEP 1) + ss_alloc_array + len@3
    // 旧 tag (GEP -8) 已废,改读源 TypeInfo;ref 元素 retain 改走元素 ObjHeader vtable (ss_retain)
    emitIR("define ptr @ss_arrayConcat(ptr %a, ptr %b) {")
    irLabel("entry")
    emitIR("  %a_lenp = getelementptr %Array, ptr %a, i32 0, i32 3")
    irLoad("alen", "i64", "%a_lenp")
    emitIR("  %b_lenp = getelementptr %Array, ptr %b, i32 0, i32 3")
    irLoad("blen", "i64", "%b_lenp")
    irAdd("total", "i64", "%alen", "%blen")
    // 继承 a 的 TypeInfo (GEP 1)
    emitIR("  %src_tip = getelementptr %Array, ptr %a, i32 0, i32 1")
    emitIR("  %src_ti = load ptr, ptr %src_tip, align 8")
    irCall("hdr", "ptr", "ss_alloc_array", "i64 8, i64 %total, ptr %src_ti")
    // Set len = total (ss_alloc_array 默认 len=0)
    emitIR("  %hdr_lenp = getelementptr %Array, ptr %hdr, i32 0, i32 3")
    irStore("i64", "%total", "%hdr_lenp")
    irICmp("has_elems", "sgt", "i64", "%total", "0")
    irBrCond("has_elems", "copy", "done")
    irLabel("copy")
    irLoadArrayData("newdata", "%hdr")
    irLoadArrayData("a_data", "%a")
    irMul("abytes", "i64", "%alen", "8")
    irCall("_1", "ptr", "memcpy", "ptr %newdata, ptr %a_data, i64 %abytes")
    irLoadArrayData("b_data", "%b")
    irGEP("dst2", "i64", "%newdata", "%alen")
    irMul("bbytes", "i64", "%blen", "8")
    irCall("_2", "ptr", "memcpy", "ptr %dst2, ptr %b_data, i64 %bbytes")
    // 若 ref array (TypeInfo == @Array_ref_type_info),元素 retain 走元素 vtable
    emitIR("  %is_ref = icmp eq ptr %src_ti, @Array_ref_type_info")
    irBrCond("is_ref", "retain.init", "done")
    irLabel("retain.init")
    irAlloca("ria", "i64", 8)
    irStore("i64", "0", "%ria")
    irBr("retain.loop")
    irLabel("retain.loop")
    irLoad("ri", "i64", "%ria")
    irICmp("rdone", "eq", "i64", "%ri", "%total")
    irBrCond("rdone", "done", "retain.body")
    irLabel("retain.body")
    irGEP("rep", "i64", "%newdata", "%ri")
    irLoad("rev", "i64", "%rep")
    irIntToPtr("rptr", "i64", "%rev")
    irCallVoid("ss_retain", "ptr %rptr")
    irAdd("rni", "i64", "%ri", "1")
    irStore("i64", "%rni", "%ria")
    irBr("retain.loop")
    irLabel("done")
    irRet("ptr", "%hdr")
    emitIR("}")
    emitIR("")

    // ss_arrayToString — "[1, 2, 3]" style output;D168 §C.6: len@3
    emitIR("define ptr @ss_arrayToString(ptr %arr) {")
    irLabel("entry")
    emitIR("  %lenp = getelementptr %Array, ptr %arr, i32 0, i32 3")
    irLoad("len", "i64", "%lenp")
    irLoadArrayData("data", "%arr")
    irAlloca("bufp", "ptr", 8)
    irAlloca("cap", "i64", 8)
    irCall("r0", "ptr", "ss_rc_alloc", "i64 256, i32 0")
    irStore("ptr", "%r0", "%bufp")
    irStore("i64", "256", "%cap")
    irStore("i8", "91", "%r0")
    irAlloca("pos", "i64", 8)
    irStore("i64", "1", "%pos")
    irAlloca("i", "i64", 8)
    irStore("i64", "0", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "slt", "i64", "%ci", "%len")
    irBrCond("cond", "body", "end")
    irLabel("body")
    irLoad("bpos", "i64", "%pos")
    irAdd("bneed", "i64", "%bpos", "260")
    irCall("bbuf", "ptr", "ss_rt_ensure_cap", "ptr %bufp, ptr %cap, i64 %bneed")
    irICmp("ci0", "sgt", "i64", "%ci", "0")
    irBrCond("ci0", "comma", "val")
    irLabel("comma")
    irLoad("cp2", "i64", "%pos")
    irGEP("dp", "i8", "%bbuf", "%cp2")
    irStore("i8", "44", "%dp")
    irAdd("cp3", "i64", "%cp2", "1")
    irGEP("dp2", "i8", "%bbuf", "%cp3")
    irStore("i8", "32", "%dp2")
    irAdd("cp4", "i64", "%cp3", "1")
    irStore("i64", "%cp4", "%pos")
    irBr("val")
    irLabel("val")
    irGEP("ep", "i64", "%data", "%ci")
    irLoad("ev", "i64", "%ep")
    irLoad("vp", "i64", "%pos")
    irGEP("dest", "i8", "%bbuf", "%vp")
    irCall("written", "i32 (ptr, i64, ptr, ...)", "snprintf", "ptr %dest, i64 256, ptr @.rt.fmt.lld, i64 %ev")
    irSext("w64", "i32", "%written", "i64")
    irAdd("np", "i64", "%vp", "%w64")
    irStore("i64", "%np", "%pos")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("end")
    irLoad("fp", "i64", "%pos")
    irAdd("fn", "i64", "%fp", "2")
    irCall("fbuf", "ptr", "ss_rt_ensure_cap", "ptr %bufp, ptr %cap, i64 %fn")
    irGEP("ep2", "i8", "%fbuf", "%fp")
    irStore("i8", "93", "%ep2")
    irAdd("fp2", "i64", "%fp", "1")
    irGEP("ep3", "i8", "%fbuf", "%fp2")
    irStore("i8", "0", "%ep3")
    irRet("ptr", "%fbuf")
    emitIR("}")
    emitIR("")
}
