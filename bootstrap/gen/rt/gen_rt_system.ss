// gen_rt_system.ss — Runtime filesystem, network, exception, isInstance, and inotify operations

// ── Filesystem ────────────────────────────────────────────────

function emitRuntimeFS() {
    // ss_mkdir
    emitIR("define i32 @ss_mkdir(ptr %path) {")
    irCall("result", "i32", "mkdir", "ptr %path, i32 493")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_mkdirp — recursive mkdir
    emitIR("define i32 @ss_mkdirp(ptr %path) {")
    irLabel("entry")
    irCall("len", "i64", "strlen", "ptr %path")
    irAdd("alloc", "i64", "%len", "1")
    irCall("buf", "ptr", "malloc", "i64 %alloc")
    irCall("_1", "ptr", "memcpy", "ptr %buf, ptr %path, i64 %len")
    irGEP("term", "i8", "%buf", "%len")
    irStore("i8", "0", "%term")
    irAlloca("i", "i64", 8)
    irStore("i64", "1", "%i")
    irBr("loop")
    irLabel("loop")
    irLoad("ci", "i64", "%i")
    irICmp("cond", "sle", "i64", "%ci", "%len")
    irBrCond("cond", "body", "final")
    irLabel("body")
    irGEP("cp", "i8", "%buf", "%ci")
    irLoad("ch", "i8", "%cp")
    irICmp("is_slash", "eq", "i8", "%ch", "47")
    irICmp("is_end", "eq", "i64", "%ci", "%len")
    irOr("should_mkdir", "i1", "%is_slash", "%is_end")
    irBrCond("should_mkdir", "do_mkdir", "next")
    irLabel("do_mkdir")
    irStore("i8", "0", "%cp")
    irCall("_2", "i32", "mkdir", "ptr %buf, i32 493")
    irStore("i8", "%ch", "%cp")
    irBr("next")
    irLabel("next")
    irAdd("ni", "i64", "%ci", "1")
    irStore("i64", "%ni", "%i")
    irBr("loop")
    irLabel("final")
    irCallVoid("free", "ptr %buf")
    irRet("i32", "0")
    emitIR("}")
    emitIR("")

    // ss_fileExists
    emitIR("define i32 @ss_fileExists(ptr %path) {")
    irAlloca("statbuf", "[144 x i8]", 8)
    irCall("rc", "i32", "stat", "ptr %path, ptr %statbuf")
    irICmp("exists", "eq", "i32", "%rc", "0")
    irZext("result", "i1", "%exists", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_fileSize
    emitIR("define i64 @ss_fileSize(ptr %path) {")
    irLabel("entry")
    irAlloca("statbuf", "[144 x i8]", 8)
    irCall("rc", "i32", "stat", "ptr %path, ptr %statbuf")
    irICmp("failed", "ne", "i32", "%rc", "0")
    irBrCond("failed", "fail", "ok")
    irLabel("ok")
    irGEP("sizep", "i8", "%statbuf", "48")
    irLoad("size", "i64", "%sizep")
    irRet("i64", "%size")
    irLabel("fail")
    irRet("i64", "-1")
    emitIR("}")
    emitIR("")

    // ss_removeFile
    emitIR("define i32 @ss_removeFile(ptr %path) {")
    irCall("result", "i32", "remove", "ptr %path")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_renameFile
    emitIR("define i32 @ss_renameFile(ptr %oldpath, ptr %newpath) {")
    irCall("result", "i32", "rename", "ptr %oldpath, ptr %newpath")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_listDir (dynamic buffer)
    emitIR("define ptr @ss_listDir(ptr %path) {")
    irLabel("entry")
    irCall("dp", "ptr", "opendir", "ptr %path")
    irICmp("isnull", "eq", "ptr", "%dp", "null")
    irBrCond("isnull", "fail", "init")
    irLabel("fail")
    irCall("empty", "ptr", "ss_rc_strdup", "ptr @.rt.str.empty")
    irRet("ptr", "%empty")
    irLabel("init")
    irAlloca("bufp", "ptr", 8)
    irAlloca("cap", "i64", 8)
    irCall("r0", "ptr", "ss_rc_alloc", "i64 4096, i32 0")
    irStore("ptr", "%r0", "%bufp")
    irStore("i64", "4096", "%cap")
    irAlloca("pos", "i64", 8)
    irStore("i64", "0", "%pos")
    irBr("loop")
    irLabel("loop")
    irCall("ent", "ptr", "readdir", "ptr %dp")
    irICmp("done", "eq", "ptr", "%ent", "null")
    irBrCond("done", "finish", "process")
    irLabel("process")
    irGEP("name", "i8", "%ent", "19")
    irCall("nlen", "i64", "strlen", "ptr %name")
    irLoad("cpos", "i64", "%pos")
    emitIR("  ; Skip . and ..")
    irLoad("c0", "i8", "%name")
    irICmp("is_dot", "eq", "i8", "%c0", "46")
    irBrCond("is_dot", "chk_dot", "copy")
    irLabel("chk_dot")
    irGEP("c1", "i8", "%name", "1")
    irLoad("c1v", "i8", "%c1")
    irICmp("is_dotdot", "eq", "i8", "%c1v", "46")
    irICmp("is_end1", "eq", "i8", "%c1v", "0")
    irOr("skip", "i1", "%is_dotdot", "%is_end1")
    irBrCond("skip", "loop", "copy")
    irLabel("copy")
    // ensure capacity for name + newline + null terminator
    irAdd("need", "i64", "%cpos", "%nlen")
    irAdd("need2", "i64", "%need", "2")
    irCall("cbuf", "ptr", "ss_rt_ensure_cap", "ptr %bufp, ptr %cap, i64 %need2")
    irGEP("dst", "i8", "%cbuf", "%cpos")
    irCall("_1", "ptr", "memcpy", "ptr %dst, ptr %name, i64 %nlen")
    irAdd("np1", "i64", "%cpos", "%nlen")
    irGEP("nlp", "i8", "%cbuf", "%np1")
    irStore("i8", "10", "%nlp")
    irAdd("np2", "i64", "%np1", "1")
    irStore("i64", "%np2", "%pos")
    irBr("loop")
    irLabel("finish")
    irCall("_2", "i32", "closedir", "ptr %dp")
    irLoad("fpos", "i64", "%pos")
    irLoad("fbuf", "ptr", "%bufp")
    irGEP("fterm", "i8", "%fbuf", "%fpos")
    irStore("i8", "0", "%fterm")
    irRet("ptr", "%fbuf")
    emitIR("}")
    emitIR("")

    // ss_timeMs
    emitIR("define i64 @ss_timeMs() {")
    irAlloca("ts", "[16 x i8]", 8)
    irCall("_1", "i32", "clock_gettime", "i32 1, ptr %ts")
    irLoad("sec", "i64", "%ts")
    irGEP("nsp", "i8", "%ts", "8")
    irLoad("nsec", "i64", "%nsp")
    irMul("ms_sec", "i64", "%sec", "1000")
    irSDiv("ms_ns", "i64", "%nsec", "1000000")
    irAdd("result", "i64", "%ms_sec", "%ms_ns")
    irRet("i64", "%result")
    emitIR("}")
    emitIR("")

    // ss_timeUnix
    emitIR("define i64 @ss_timeUnix() {")
    irCall("result", "i64", "time", "ptr null")
    irRet("i64", "%result")
    emitIR("}")
    emitIR("")
}

// ── Network ───────────────────────────────────────────────────

function emitRuntimeNet() {
    // ss_tcpListen
    emitIR("define i32 @ss_tcpListen(i32 %port) {")
    irLabel("entry")
    irCall("fd", "i32", "socket", "i32 2, i32 1, i32 0")
    irICmp("bad", "slt", "i32", "%fd", "0")
    irBrCond("bad", "fail", "setsock")
    irLabel("setsock")
    irAlloca("optval", "i32", 4)
    irStore("i32", "1", "%optval")
    irCall("_1", "i32", "setsockopt", "i32 %fd, i32 1, i32 2, ptr %optval, i32 4")
    irAlloca("addr", "[16 x i8]", 4)
    irCall("_2", "ptr", "memset", "ptr %addr, i32 0, i64 16")
    irStore("i16", "2", "%addr")
    irTrunc("port16", "i32", "%port", "i16")
    irCall("portn", "i16", "htons", "i16 %port16")
    irGEP("pptr", "i8", "%addr", "2")
    irStore("i16", "%portn", "%pptr")
    irCall("br", "i32", "bind", "i32 %fd, ptr %addr, i32 16")
    irICmp("bfail", "slt", "i32", "%br", "0")
    irBrCond("bfail", "close_fail", "do_listen")
    irLabel("do_listen")
    irCall("lr", "i32", "listen", "i32 %fd, i32 128")
    irICmp("lfail", "slt", "i32", "%lr", "0")
    irBrCond("lfail", "close_fail", "done")
    irLabel("done")
    irRet("i32", "%fd")
    irLabel("close_fail")
    irCall("_3", "i32", "close", "i32 %fd")
    irBr("fail")
    irLabel("fail")
    irRet("i32", "-1")
    emitIR("}")
    emitIR("")

    // ss_tcpAccept
    emitIR("define i32 @ss_tcpAccept(i32 %fd) {")
    irCall("client", "i32", "accept", "i32 %fd, ptr null, ptr null")
    irRet("i32", "%client")
    emitIR("}")
    emitIR("")

    // ss_tcpRead
    emitIR("define ptr @ss_tcpRead(i32 %fd, i32 %maxlen) {")
    irSext("maxlen64", "i32", "%maxlen", "i64")
    irAdd("alloc", "i64", "%maxlen64", "1")
    irCall("buf", "ptr", "ss_rc_alloc", "i64 %alloc, i32 0")
    irCall("nread", "i64", "read", "i32 %fd, ptr %buf, i64 %maxlen64")
    irICmp("neg", "slt", "i64", "%nread", "0")
    irSelect("safe", "neg", "i64", "0", "%nread")
    irGEP("term", "i8", "%buf", "%safe")
    irStore("i8", "0", "%term")
    irRet("ptr", "%buf")
    emitIR("}")
    emitIR("")

    // ss_tcpWrite
    emitIR("define i32 @ss_tcpWrite(i32 %fd, ptr %data) {")
    irCall("len", "i64", "strlen", "ptr %data")
    irCall("nwritten", "i64", "write", "i32 %fd, ptr %data, i64 %len")
    irTrunc("result", "i64", "%nwritten", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_tcpWriteBytes
    emitIR("define i32 @ss_tcpWriteBytes(i32 %fd, ptr %data, i32 %len) {")
    irSext("len64", "i32", "%len", "i64")
    irCall("nwritten", "i64", "write", "i32 %fd, ptr %data, i64 %len64")
    irTrunc("result", "i64", "%nwritten", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")

    // ss_tcpClose
    emitIR("define void @ss_tcpClose(i32 %fd) {")
    irCall("_1", "i32", "close", "i32 %fd")
    irRetVoid()
    emitIR("}")
    emitIR("")

    // hints AF_INET + SOCK_STREAM, service NULL with port patched into sockaddr_in.sin_port@2 (htons).
    // addrinfo musl/Linux layout 48 bytes: ai_flags@0, ai_family@4, ai_socktype@8, ai_protocol@12, ai_addrlen@16, ai_addr@24.
    emitIR("define i32 @ss_tcpConnect(ptr %host, i32 %port) {")
    irLabel("entry")
    irAlloca("hints", "[48 x i8]", 8)
    irCall("_1", "ptr", "memset", "ptr %hints, i32 0, i64 48")
    irGEP("famp", "i8", "%hints", "4")
    irStore("i32", "2", "%famp")
    irGEP("typep", "i8", "%hints", "8")
    irStore("i32", "1", "%typep")
    irAlloca("resp", "ptr", 8)
    irCall("gai", "i32", "getaddrinfo", "ptr %host, ptr null, ptr %hints, ptr %resp")
    irICmp("gai_bad", "ne", "i32", "%gai", "0")
    irBrCond("gai_bad", "fail", "make_socket")
    irLabel("make_socket")
    irCall("fd", "i32", "socket", "i32 2, i32 1, i32 0")
    irICmp("fd_bad", "slt", "i32", "%fd", "0")
    irBrCond("fd_bad", "free_fail", "do_connect")
    irLabel("do_connect")
    irLoad("res", "ptr", "%resp")
    irGEP("ad_p", "i8", "%res", "24")
    irLoad("ad", "ptr", "%ad_p")
    irGEP("al_p", "i8", "%res", "16")
    irLoad("al", "i32", "%al_p")
    irTrunc("port16", "i32", "%port", "i16")
    irCall("port_n", "i16", "htons", "i16 %port16")
    irGEP("port_dst", "i8", "%ad", "2")
    irStore("i16", "%port_n", "%port_dst")
    irCall("conn", "i32", "connect", "i32 %fd, ptr %ad, i32 %al")
    irICmp("conn_bad", "slt", "i32", "%conn", "0")
    irBrCond("conn_bad", "close_free_fail", "success")
    irLabel("success")
    irCallVoid("freeaddrinfo", "ptr %res")
    irRet("i32", "%fd")
    irLabel("close_free_fail")
    irCall("_2", "i32", "close", "i32 %fd")
    irBr("free_fail")
    irLabel("free_fail")
    irLoad("res2", "ptr", "%resp")
    irCallVoid("freeaddrinfo", "ptr %res2")
    irBr("fail")
    irLabel("fail")
    irRet("i32", "-1")
    emitIR("}")
    emitIR("")

    // Caller-provided buf so callers can stitch header+payload reads without per-read allocation.
    // Returns bytes actually read; < len = EOF mid-stream.
    emitIR("define i32 @ss_tcpReadBytes(i32 %fd, ptr %buf, i32 %len) {")
    irLabel("entry")
    irSext("len64", "i32", "%len", "i64")
    irAlloca("so_far", "i64", 8)
    irStore("i64", "0", "%so_far")
    irBr("loop")
    irLabel("loop")
    irLoad("cur", "i64", "%so_far")
    irICmp("done", "sge", "i64", "%cur", "%len64")
    irBrCond("done", "finish", "body")
    irLabel("body")
    irSub("remain", "i64", "%len64", "%cur")
    irGEP("dst", "i8", "%buf", "%cur")
    irCall("n", "i64", "read", "i32 %fd, ptr %dst, i64 %remain")
    irICmp("eof", "sle", "i64", "%n", "0")
    irBrCond("eof", "finish", "inc")
    irLabel("inc")
    irAdd("new_cur", "i64", "%cur", "%n")
    irStore("i64", "%new_cur", "%so_far")
    irBr("loop")
    irLabel("finish")
    irLoad("final", "i64", "%so_far")
    irTrunc("result", "i64", "%final", "i32")
    irRet("i32", "%result")
    emitIR("}")
    emitIR("")
}

// ── Exception handling ────────────────────────────────────────

function emitRuntimeExceptions() {
    // ss_throw: store message, longjmp if handler exists, else print+exit
    emitIR("define void @ss_throw(ptr %msg) {")
    irLabel("entry")
    irStore("ptr", "%msg", "@ss_exc_msg")
    irLoad("depth", "i32", "@ss_exc_depth")
    irICmp("has_handler", "sgt", "i32", "%depth", "0")
    irBrCond("has_handler", "do_jump", "no_handler")
    irLabel("do_jump")
    irSub("d1", "i32", "%depth", "1")
    irMul("offset", "i32", "%d1", "200")
    irSext("off64", "i32", "%offset", "i64")
    irGEP("bufptr", "i8", "@ss_jmpbuf", "%off64")
    irCallVoid("longjmp", "ptr %bufptr, i32 1")
    emitIR("  unreachable")
    irLabel("no_handler")
    irCall("_1", "ptr", "ss_string_concat", "ptr @.rt.str.uncaught, ptr %msg")
    emitIR("  call i32 @puts(ptr %_1)")
    irCallVoid("exit", "i32 1")
    emitIR("  unreachable")
    emitIR("}")
    emitIR("")
}

function emitRuntimeIsInstance() {
    // ss_isinstance(ptr %obj, ptr %target_name) → i32 (1=match, 0=no)
    // Walks TypeInfo parent chain comparing class name with target
    emitIR("define i32 @ss_isinstance(ptr %obj, ptr %target_name) {")
    irLabel("entry")
    // Null object check — return 0 (false) for null
    emitIR("  %obj_null = icmp eq ptr %obj, null")
    emitIR("  br i1 %obj_null, label %no_match, label %load_ti")
    irLabel("load_ti")
    // Load TypeInfo pointer (offset 1 in object)
    emitIR("  %ti_gep = getelementptr ptr, ptr %obj, i32 1")
    emitIR("  %ti = load ptr, ptr %ti_gep, align 8")
    emitIR("  br label %loop")
    irLabel("loop")
    emitIR("  %cur_ti = phi ptr [ %ti, %load_ti ], [ %parent_ti, %next ]")
    emitIR("  %is_null = icmp eq ptr %cur_ti, null")
    emitIR("  br i1 %is_null, label %no_match, label %check")
    irLabel("check")
    // Load name (index 4 in TypeInfo)
    emitIR("  %name_gep = getelementptr %TypeInfo, ptr %cur_ti, i32 0, i32 4")
    emitIR("  %name = load ptr, ptr %name_gep, align 8")
    emitIR("  %cmp = call i32 @strcmp(ptr %name, ptr %target_name)")
    emitIR("  %eq = icmp eq i32 %cmp, 0")
    emitIR("  br i1 %eq, label %match, label %next")
    irLabel("next")
    // Load parent TypeInfo (index 6 in TypeInfo)
    emitIR("  %parent_gep = getelementptr %TypeInfo, ptr %cur_ti, i32 0, i32 6")
    emitIR("  %parent_ti = load ptr, ptr %parent_gep, align 8")
    emitIR("  br label %loop")
    irLabel("match")
    emitIR("  ret i32 1")
    irLabel("no_match")
    emitIR("  ret i32 0")
    emitIR("}")
    emitIR("")
}

// ── inotify file watcher ─────────────────────────────────────

function emitRuntimeInotify() {
    // _ss_inotify_init() → i32: create inotify instance
    emitIR("define i32 @_ss_inotify_init() {")
    irCall("fd", "i32", "inotify_init", "")
    irRet("i32", "%fd")
    emitIR("}")
    emitIR("")

    // _ss_inotify_add_watch(fd, path, recursive) → i32
    // IN_MODIFY(0x2) | IN_CREATE(0x100) | IN_DELETE(0x200) | IN_MOVED_TO(0x80) = 898
    // If recursive=1, traverses subdirectories via opendir/readdir
    emitIR("define i32 @_ss_inotify_add_watch(i32 %fd, ptr %path, i32 %recursive) {")
    irLabel("entry")
    irCall("wd", "i32", "inotify_add_watch", "i32 %fd, ptr %path, i32 898")
    irICmp("not_rec", "eq", "i32", "%recursive", "0")
    irBrCond("not_rec", "done", "scan")
    irLabel("scan")
    irCall("dp", "ptr", "opendir", "ptr %path")
    irICmp("dp_null", "eq", "ptr", "%dp", "null")
    irBrCond("dp_null", "done", "rd_loop")
    irLabel("rd_loop")
    irCall("ent", "ptr", "readdir", "ptr %dp")
    irICmp("ent_null", "eq", "ptr", "%ent", "null")
    irBrCond("ent_null", "close_dir", "chk_type")
    irLabel("chk_type")
    // d_type at offset 18 in dirent (DT_DIR = 4)
    irGEP("dtp", "i8", "%ent", "18")
    irLoad("dt", "i8", "%dtp")
    irICmp("is_dir", "eq", "i8", "%dt", "4")
    irBrCond("is_dir", "chk_name", "rd_loop")
    irLabel("chk_name")
    // d_name at offset 19 — skip "." and ".."
    irGEP("name", "i8", "%ent", "19")
    irLoad("c0", "i8", "%name")
    irICmp("is_dot", "eq", "i8", "%c0", "46")  // ASCII '.'
    irBrCond("is_dot", "chk_dot2", "add_sub")
    irLabel("chk_dot2")
    irGEP("c1p", "i8", "%name", "1")
    irLoad("c1", "i8", "%c1p")
    irICmp("is_end", "eq", "i8", "%c1", "0")
    irICmp("is_dd", "eq", "i8", "%c1", "46")
    irOr("skip", "i1", "%is_end", "%is_dd")
    irBrCond("skip", "rd_loop", "add_sub")
    irLabel("add_sub")
    // Build full path: path + "/" + name
    irCall("plen", "i64", "strlen", "ptr %path")
    irCall("nlen", "i64", "strlen", "ptr %name")
    irAdd("total", "i64", "%plen", "%nlen")
    irAdd("total2", "i64", "%total", "2")
    irCall("buf", "ptr", "malloc", "i64 %total2")
    irCall("_1", "ptr", "memcpy", "ptr %buf, ptr %path, i64 %plen")
    irGEP("slp", "i8", "%buf", "%plen")
    irStore("i8", "47", "%slp")  // ASCII '/'
    irAdd("pl1", "i64", "%plen", "1")
    irGEP("ndst", "i8", "%buf", "%pl1")
    irCall("_2", "ptr", "memcpy", "ptr %ndst, ptr %name, i64 %nlen")
    irAdd("tend", "i64", "%pl1", "%nlen")
    irGEP("term", "i8", "%buf", "%tend")
    irStore("i8", "0", "%term")
    irCall("_3", "i32", "_ss_inotify_add_watch", "i32 %fd, ptr %buf, i32 1")
    irCallVoid("free", "ptr %buf")
    irBr("rd_loop")
    irLabel("close_dir")
    irCall("_4", "i32", "closedir", "ptr %dp")
    irBr("done")
    irLabel("done")
    irRet("i32", "%wd")
    emitIR("}")
    emitIR("")

    // _ss_inotify_poll(fd, timeout_ms) → ptr: poll for change, return filename
    emitIR("define ptr @_ss_inotify_poll(i32 %fd, i32 %timeout_ms) {")
    irLabel("entry")
    // Setup pollfd: { fd:i32, events:i16, revents:i16 }
    irAlloca("pfd", "[8 x i8]", 4)
    irStore("i32", "%fd", "%pfd")
    irGEP("evp", "i8", "%pfd", "4")
    irStore("i16", "1", "%evp")
    irGEP("revp", "i8", "%pfd", "6")
    irStore("i16", "0", "%revp")
    irCall("rc", "i32", "poll", "ptr %pfd, i64 1, i32 %timeout_ms")
    irICmp("no_ev", "sle", "i32", "%rc", "0")
    irBrCond("no_ev", "empty", "do_read")
    irLabel("do_read")
    irAlloca("ebuf", "[4096 x i8]", 8)
    irCall("n", "i64", "read", "i32 %fd, ptr %ebuf, i64 4096")
    irICmp("bad", "sle", "i64", "%n", "0")
    irBrCond("bad", "empty", "parse")
    irLabel("parse")
    // inotify_event: { wd:i32, mask:u32, cookie:u32, len:u32, name[] }
    irGEP("lenp", "i8", "%ebuf", "12")
    irLoad("len", "i32", "%lenp")
    irICmp("has_name", "sgt", "i32", "%len", "0")
    irBrCond("has_name", "get_name", "empty")
    irLabel("get_name")
    irGEP("nameptr", "i8", "%ebuf", "16")
    irCall("result", "ptr", "ss_rc_strdup", "ptr %nameptr")
    irRet("ptr", "%result")
    irLabel("empty")
    irCall("estr", "ptr", "ss_rc_strdup", "ptr @.rt.str.empty")
    irRet("ptr", "%estr")
    emitIR("}")
    emitIR("")

    // _ss_inotify_close(fd) → void
    emitIR("define void @_ss_inotify_close(i32 %fd) {")
    irCall("_1", "i32", "close", "i32 %fd")
    irRetVoid()
    emitIR("}")
    emitIR("")
}
